  "sentences": [
    {
      "id": "s1",
      "paragraph": 1,
      "text": "Your AI assistant knows a lot about code.",
      "start": 0.9,
      "end": 3.449
    },
    {
      "id": "s2",
      "paragraph": 1,
      "text": "A plugin teaches it how to build on Power Platform.",
      "start": 3.769,
      "end": 6.707
    },
    {
      "id": "s3",
      "paragraph": 2,
      "text": "You install a plugin once, and it adds a set of skills.",
      "start": 7.327,
      "end": 10.396
    },
    {
      "id": "s4",
      "paragraph": 3,
      "text": "Each skill is one job, written down step by step.",
      "start": 11.016,
      "end": 14.06
    },
    {
      "id": "s5",
      "paragraph": 3,
      "text": "Creating a Power Pages site is one skill.",
      "start": 14.38,
      "end": 16.794
    },
    {
      "id": "s6",
      "paragraph": 3,
      "text": "Deploying it is another.",
      "start": 17.114,
      "end": 18.527
    },
    {
      "id": "s7",
      "paragraph": 4,
      "text": "When you describe what you need, your assistant picks the right skill and follows its steps.",
      "start": 19.147,
      "end": 24.102
    },
    {
      "id": "s8",
      "paragraph": 4,
      "text": "It asks before it runs commands or changes files.",
      "start": 24.422,
      "end": 27.332
    },
    {
      "id": "s9",
      "paragraph": 5,
      "text": "So, plugins are what you install, and skills are the jobs inside them.",
      "start": 27.952,
      "end": 32.264
    },
    {
      "id": "s10",
      "paragraph": 5,
      "text": "You just ask.",
      "start": 32.584,
      "end": 33.548
    }
  ]
}
