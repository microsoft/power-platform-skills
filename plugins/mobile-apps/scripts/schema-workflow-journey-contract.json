{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow Journey Contract",
  "description": "Ordered, user-visible steps that complete each core job. A step owns a surface, which may be a screen, a section, a sheet, a modal, a flow step, or a contextual action.",
  "type": "object",
  "required": ["schemaVersion", "contractType", "experienceRevision", "scopeRevision", "journeys"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractType": { "const": "workflow-journey" },
    "experienceRevision": { "$ref": "#/definitions/revision" },
    "scopeRevision": { "$ref": "#/definitions/revision" },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["id", "jobId", "name", "steps", "successOutcome", "failureRecovery"],
        "properties": {
          "id": { "$ref": "#/definitions/slug" },
          "jobId": { "$ref": "#/definitions/slug" },
          "name": { "type": "string", "minLength": 3, "maxLength": 80 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 14,
            "items": {
              "type": "object",
              "required": ["id", "order", "label", "surface", "userAction", "dataOperation", "entryCondition", "exitCondition", "states"],
              "properties": {
                "id": { "$ref": "#/definitions/slug" },
                "order": { "type": "integer", "minimum": 1, "maximum": 14 },
                "label": { "type": "string", "minLength": 3, "maxLength": 80 },
                "satisfies": {
                  "description": "Critical step ids from the core job that this journey step completes.",
                  "type": "array",
                  "maxItems": 6,
                  "items": { "$ref": "#/definitions/slug" },
                  "uniqueItems": true
                },
                "surface": {
                  "type": "object",
                  "required": ["kind", "screenId"],
                  "properties": {
                    "kind": { "enum": ["screen", "section", "sheet", "modal", "flow-step", "contextual-action"] },
                    "screenId": { "$ref": "#/definitions/slug" },
                    "detail": { "type": "string", "maxLength": 200 }
                  },
                  "additionalProperties": false
                },
                "userAction": { "type": "string", "minLength": 5, "maxLength": 160 },
                "dataOperation": {
                  "type": "object",
                  "required": ["kind", "classification"],
                  "properties": {
                    "kind": { "enum": ["read", "create", "update", "delete", "local-state", "external-call", "none"] },
                    "entity": { "type": "string", "maxLength": 80 },
                    "classification": { "$ref": "#/definitions/dataClassification" },
                    "note": { "type": "string", "maxLength": 240 }
                  },
                  "additionalProperties": false
                },
                "entryCondition": { "type": "string", "minLength": 5, "maxLength": 200 },
                "exitCondition": { "type": "string", "minLength": 5, "maxLength": 200 },
                "states": { "$ref": "#/definitions/stateSet" },
                "continuation": { "type": "string", "maxLength": 200 }
              },
              "additionalProperties": false
            }
          },
          "successOutcome": { "type": "string", "minLength": 10, "maxLength": 240 },
          "failureRecovery": { "type": "string", "minLength": 10, "maxLength": 240 },
          "resumable": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 2, "maxLength": 60 },
    "dataClassification": {
      "enum": ["safe-presentation", "sample", "schema-backed", "proposed-requires-approval"]
    },
    "stateSet": {
      "type": "object",
      "required": ["loading", "empty", "error", "populated"],
      "properties": {
        "loading": { "type": "string", "minLength": 3, "maxLength": 200 },
        "empty": { "type": "string", "minLength": 3, "maxLength": 200 },
        "error": { "type": "string", "minLength": 3, "maxLength": 200 },
        "populated": { "type": "string", "minLength": 3, "maxLength": 200 },
        "offline": { "type": "string", "minLength": 3, "maxLength": 200 },
        "recovery": { "type": "string", "minLength": 3, "maxLength": 200 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
