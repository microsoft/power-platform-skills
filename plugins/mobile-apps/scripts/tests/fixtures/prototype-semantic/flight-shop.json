      "mediaStrategy": { "role": "Product media is substantive evidence and the dominant discovery signal.", "treatment": "Use inspectable aspect-ratio media with cached CDN primary and bundled fallback.", "accessibility": "Every image binds domain alt text and preserves readable product facts outside the image.", "licensingIntent": "approved-remote-source", "connectivityRationale": "Approved remote product media is cached on device and every required image has a bundled local fallback." },
