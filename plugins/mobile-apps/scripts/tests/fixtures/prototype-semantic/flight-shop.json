            { "key": "displayName", "displayName": "Display name", "type": "text", "required": true, "maximumLength": 80 },
            { "key": "status", "displayName": "Status", "type": "choice", "required": true, "choiceKey": "CartStatus" }
          ]
        },
        {
          "key": "CartItem", "displayName": "Cart item", "displayPluralName": "Cart items", "description": "A canonical product selection and quantity inside the passenger bag.", "primaryNameField": "label", "estimatedPrototypeRows": 2,
