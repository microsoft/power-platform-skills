function storageGet(key){
try{
return sessionStorage.getItem(key)||''}
catch{
return''}
}
function storageSet(key,value){
try{
if(value)sessionStorage.setItem(key,value);
else sessionStorage.removeItem(key)}
catch{
}
}
function announce(message){
document.getElementById('live-announcer').textContent=message}
function rememberUiState(message){
const selected=document.querySelector('.tabs [aria-selected="true"]');
if(selected)storageSet('build-plan-active-tab',selected.id.slice(4));
const active=document.activeElement;
if(active&&active.id)storageSet('build-plan-focus-id',active.id);
if(message)storageSet('build-plan-announcement',message)}
function reloadPlan(message){
