setValue('column-min',column&&column.minValue);
setValue('column-max',column&&column.maxValue);
setValue('column-precision',column&&column.precision||2);
for(const option of column&&column.options||[])addOption(option);
configureColumn()}
  if(mode==='add-relationship'||mode==='update-relationship'){
const table=tableByName(target.table);
