async function postJson(path,payload){
const response=await fetch(path,{
method:'POST',headers:{
'content-type':'application/json'}
,body:JSON.stringify(payload)}
);
const result=await response.json();
if(!response.ok){
const error=new Error(result.error||'The Build Plan change was rejected.');
error.status=response.status;
error.currentRevision=result.currentRevision;
throw error}
return result}
async function previewRemoval(button){
pendingRemoval=null;
document.getElementById('removal-target').textContent='Checking dependencies…';
document.getElementById('removal-affected').replaceChildren();
document.getElementById('removal-blockers').replaceChildren();
document.getElementById('removal-confirm').disabled=true;
removalDialog.showModal();
announce('Checking removal impact');
try{
const command=removalCommand(button);
const impact=await postJson('/api/data-model/impact',command);
pendingRemoval={
...command,expectedImpactRevision:impact.impactRevision}
;
document.getElementById('removal-target').textContent=impact.target;
for(const item of impact.affectedItems){
const row=document.createElement('li');
row.textContent=item.label+' · '+item.kind;
document.getElementById('removal-affected').appendChild(row)}
for(const item of impact.blockers){
const row=document.createElement('li');
row.textContent=item.message;
document.getElementById('removal-blockers').appendChild(row)}
document.getElementById('removal-blockers-section').hidden=impact.allowed;
document.getElementById('removal-confirm').disabled=!impact.allowed;
announce(impact.allowed?'Removal impact ready for review':'Removal blocked by canonical dependencies')}
catch(error){
document.getElementById('removal-target').textContent=error.message;
document.getElementById('removal-blockers-section').hidden=false;
const row=document.createElement('li');
row.textContent=error.message;
document.getElementById('removal-blockers').appendChild(row);
announce('Removal impact check failed')}
}
