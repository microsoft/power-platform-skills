function removalCommand(button){
const base={
expectedRevision:BUILD_PLAN_MODEL.dataModelRevision}
;
if(button.dataset.removeTable)return {
...base,type:'remove-table',tableLogicalName:button.dataset.removeTable}
;
if(button.dataset.removeColumn)return {
...base,type:'remove-column',tableLogicalName:button.dataset.table,columnLogicalName:button.dataset.removeColumn}
;
