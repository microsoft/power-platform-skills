{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/microsoft/power-platform-skills/main/plugins/mobile-apps/scripts/schemas/mobile-plugin-input.v3.schema.json",
  "title": "Canvas-to-native mobile plugin input",
  "type": "object",
  "required": ["schemaVersion", "migrationMode", "source", "app", "dataModelPlan", "screenPlan", "nativePlan", "pcfPlan", "workflowPlan", "behaviorPlan", "criticalObligations", "riskReport", "unsupported"],
  "properties": {
    "schemaVersion": { "const": "3" },
    "migrationMode": { "enum": ["faithful", "modernize", "repair-modernize"] },
    "source": {
      "type": "object",
      "required": ["powerAppsYamlSchemaValidation"],
      "properties": {
        "powerAppsYamlSchemaValidation": {
          "type": "object",
          "required": ["schema", "version", "id", "sourceCommit", "sha256", "sourceTreeSha256", "sourceFileCount", "sourceInputSha256", "sourceInputFileCount", "sectionCounts"],
          "properties": {
            "schema": { "const": "power-apps-yaml-validation-report-v1" },
            "version": { "const": "3.0" },
            "id": { "const": "http://powerapps.com/schemas/pa-yaml/v3.0/pa.schema" },
            "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "sourceTreeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "sourceFileCount": { "type": "integer", "minimum": 1 },
            "sourceInputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "sourceInputFileCount": { "type": "integer", "minimum": 1 },
            "sectionCounts": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "integer", "minimum": 0 } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "app": {
      "type": "object",
      "required": ["name", "startScreen"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "startScreen": { "type": "string", "minLength": 1 },
        "auth": { "enum": ["entra", "none", null] }
      },
      "additionalProperties": true
    },
    "dataModelPlan": {
      "type": "object",
      "required": ["dataverseTables", "connectionRequirements"],
      "properties": {
        "dataverseTables": { "type": "array" },
        "connectionRequirements": { "type": "array" },
        "flows": { "type": "array" },
        "unresolvedDataSources": { "type": "array" }
      },
      "additionalProperties": true
    },
    "screenPlan": {
      "type": "object",
      "required": ["screens", "navigationEdges"],
      "properties": {
        "screens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "route", "file", "planFile"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "route": { "type": "string", "pattern": "^/" },
              "file": { "type": "string", "pattern": "^app/" },
              "planFile": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        },
        "navigationEdges": { "type": "array" }
      },
      "additionalProperties": true
    },
    "nativePlan": { "type": "object" },
    "pcfPlan": {
      "type": "object",
      "required": ["file", "schema", "stats"],
      "properties": {
        "file": { "const": "pcf-plan.json" },
        "schema": { "const": "pcf-plan-v1" },
        "stats": {
          "type": "object",
          "required": ["total", "discoveryComplete", "pendingApproval", "approved", "blocked", "byDisposition", "proposed"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "discoveryComplete": { "type": "boolean" },
            "pendingApproval": { "type": "integer", "minimum": 0 },
            "approved": { "type": "integer", "minimum": 0 },
            "blocked": { "type": "integer", "minimum": 0 },
            "byDisposition": { "type": "object" },
            "proposed": { "type": "object" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "workflowPlan": {
      "type": "object",
      "required": ["file", "gateSummaryFile", "gateSummarySchema", "schema", "stats"],
      "properties": {
        "file": { "const": "workflows.json" },
        "gateSummaryFile": { "const": "workflow-gate-summary.json" },
        "gateSummarySchema": { "const": "workflow-gate-summary-v1" },
        "schema": { "const": "workflow-plan-v1" },
        "stats": {
          "type": "object",
          "required": ["handlersScanned", "total", "pathologicalHandlers", "totalSteps", "mappedBehaviors", "coreMappedBehaviors", "regenerableMappedBehaviors", "requiredDecisions", "unresolvedDecisions", "pendingApproval", "approved", "blocked"],
          "properties": {
            "handlersScanned": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 },
            "pathologicalHandlers": { "type": "integer", "minimum": 0 },
            "totalSteps": { "type": "integer", "minimum": 0 },
            "mappedBehaviors": { "type": "integer", "minimum": 0 },
            "coreMappedBehaviors": { "type": "integer", "minimum": 0 },
            "regenerableMappedBehaviors": { "type": "integer", "minimum": 0 },
            "requiredDecisions": { "type": "integer", "minimum": 0 },
            "unresolvedDecisions": { "type": "integer", "minimum": 0 },
            "pendingApproval": { "type": "integer", "minimum": 0 },
            "approved": { "type": "integer", "minimum": 0 },
            "blocked": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "behaviorPlan": {
      "type": "object",
      "required": ["file", "schema", "appShard", "stats"],
      "properties": {
        "file": { "const": "behavior-contract.json" },
        "schema": { "const": "behavior-contract-v1" },
        "appShard": { "type": "string", "pattern": "^behavior-shards/" },
        "stats": {
          "type": "object",
          "required": ["totalBehaviors", "coreBehaviors", "regenerableBehaviors", "intentHints", "unmatchedFormulas", "shards", "dependencyEdges", "stateKeys", "workflowRefs"],
          "properties": {
            "totalBehaviors": { "type": "integer", "minimum": 0 },
            "coreBehaviors": { "type": "integer", "minimum": 0 },
            "regenerableBehaviors": { "type": "integer", "minimum": 0 },
            "intentHints": { "type": "integer", "minimum": 0 },
            "unmatchedFormulas": { "type": "integer", "minimum": 0 },
            "shards": { "type": "integer", "minimum": 1 },
            "dependencyEdges": { "type": "integer", "minimum": 0 },
            "stateKeys": { "type": "integer", "minimum": 0 },
            "workflowRefs": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "criticalObligations": {
      "type": "object",
      "required": ["file", "schema", "sourceDigest", "stats"],
      "properties": {
        "file": { "const": "critical-obligations.json" },
        "schema": { "const": "critical-obligations-v1" },
        "sourceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "stats": {
          "type": "object",
          "required": ["total", "critical", "componentCommands", "componentCommandPlacements", "sourceScreens", "navigation", "savedViews", "designBaselines", "startScreens"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "critical": { "type": "integer", "minimum": 0 },
            "componentCommands": { "type": "integer", "minimum": 0 },
            "componentCommandPlacements": { "type": "integer", "minimum": 0 },
            "sourceScreens": { "type": "integer", "minimum": 0 },
            "navigation": { "type": "integer", "minimum": 0 },
            "savedViews": { "type": "integer", "minimum": 0 },
            "designBaselines": { "type": "integer", "minimum": 0 },
            "startScreens": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "riskReport": { "type": "array" },
    "unsupported": { "type": "array" }
  },
  "additionalProperties": true
}
