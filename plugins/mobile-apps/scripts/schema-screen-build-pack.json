{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Power Apps Mobile Screen Build Pack",
  "type": "object",
  "required": ["schemaVersion", "revision", "sources", "sourcePaths", "experience", "design", "shell", "navigation", "fixtures", "screens", "execution", "buildOrder", "invalidation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sources": {
      "type": "object",
      "required": ["plan", "experienceContract", "screenContract", "foundationContract", "designRecipe", "dataIntent"],
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "sourcePaths": { "type": "object" },
    "experience": { "type": "object", "required": ["audience", "primaryJob", "entryMode", "primarySurface", "forbiddenDefaults"] },
    "design": { "type": "object", "required": ["tokensPath", "primitives"] },
    "shell": {
      "type": "object",
      "required": ["safeAreaOwner", "rootSafeAreaProviderOnly", "headerModes"],
      "properties": {
        "safeAreaOwner": { "const": "screen" },
        "rootSafeAreaProviderOnly": { "const": true },
        "headerModes": { "type": "object" }
      }
    },
    "navigation": {
      "type": "object",
      "required": ["model", "modelSource", "initialRoute", "keyFlowRoute", "keyFlowRoutes", "profileRoute", "routes"],
      "properties": {
        "model": { "enum": ["tabs-stack", "stack", "modal-flow", "drawer", "other"] },
        "modelSource": { "enum": ["approved-screen-plan", "experience-contract"] },
        "initialRoute": { "type": "string", "pattern": "^/" },
        "keyFlowRoute": { "type": "string", "pattern": "^/" },
        "keyFlowRoutes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^/" }, "uniqueItems": true },
        "profileRoute": { "const": "/(app)/profile" },
        "routes": { "type": "array", "items": { "type": "string", "pattern": "^/" }, "uniqueItems": true }
      }
    },
    "fixtures": {
      "type": "object",
      "required": ["adapter", "entities", "assetPolicy", "assetManifest", "viewModel", "recordIdentity", "mediaPolicy", "mediaManifest", "mediaFields"],
      "properties": {
        "entities": { "type": "array" },
        "assetManifest": { "const": "assets/experience/manifest.json" },
        "viewModel": { "const": "src/generated/experience-view-model.ts" },
        "recordIdentity": { "const": "stable-primary-key" },
        "mediaPolicy": { "enum": ["local-first", "remote-cdn-cached", "remote-allowed", "not-applicable"] },
        "mediaManifest": { "const": "assets/experience/manifest.json" },
        "mediaFields": { "const": ["imageUrl", "imageAltText", "imageCacheKey", "imageAssetKey"] }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "route", "file", "role", "presentation", "nativeIntent", "headerMode", "data"],
        "properties": {
          "role": { "enum": ["primary", "key-flow", "profile", "supporting"] },
          "navigationRole": { "type": "string" },
          "archetype": { "type": ["string", "null"] },
          "presentation": { "type": "string" },
          "nativeIntent": { "type": ["string", "null"] },
          "headerMode": { "enum": ["root", "back", "close", "none"] },
          "data": {
            "type": "object",
            "required": ["adapter", "entities", "viewModel", "recordIdentity", "mediaPolicy", "mediaFields"],
            "properties": {
              "entities": { "type": "array" },
              "viewModel": { "const": "src/generated/experience-view-model.ts" },
              "recordIdentity": { "const": "stable-primary-key" },
              "mediaPolicy": { "enum": ["local-first", "remote-cdn-cached", "remote-allowed", "not-applicable"] },
              "mediaFields": { "const": ["imageUrl", "imageAltText", "imageCacheKey", "imageAssetKey"] }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "required": ["canary", "supportingWaves", "metroAfterCanary"],
      "properties": {
        "canary": {
          "type": "object",
          "required": ["screenIds", "routes"],
          "properties": {
            "screenIds": { "type": "array", "minItems": 2, "items": { "type": "string" }, "uniqueItems": true },
            "routes": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^/" }, "uniqueItems": true }
          }
        },
        "supportingWaves": { "type": "array" },
        "metroAfterCanary": { "const": true }
      }
    },
    "buildOrder": { "type": "array", "minItems": 3 },
    "invalidation": { "type": "object", "required": ["screenDependencies", "fixtureDependencies", "validatorDependencies"] }
  },
  "additionalProperties": false
}