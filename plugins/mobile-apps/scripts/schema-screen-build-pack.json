{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Power Apps Mobile Screen Build Pack",
  "type": "object",
  "required": ["schemaVersion", "screenContractVersion", "revision", "uiContractFingerprint", "sources", "sourcePaths", "experience", "context", "productStructure", "capabilityBindings", "nativeCanary", "journey", "design", "shell", "navigation", "execution", "fixtures", "screens", "builderWaves", "buildOrder", "invalidation"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "screenContractVersion": { "const": 3 },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "uiContractFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sources": {
      "type": "object",
      "required": ["confirmedBrief", "packageManifest", "experienceContract", "screenContract", "contextEnrichment", "workflowJourney", "navigationContract", "navigationShell", "foundationContract", "foundationRuntime", "designRecipe", "tokens", "domainModel", "domainLayer", "executionContract"],
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "sourcePaths": { "type": "object" },
    "experience": { "type": "object", "required": ["audience", "primaryJob", "entryMode", "primarySurface", "assetPolicy", "mediaIntent", "presentationIntent", "navigationIntent", "forbiddenDefaults"] },
    "context": {
      "type": "object",
      "required": ["mode", "forbiddenInferences"],
      "properties": {
        "mode": { "type": "string" },
        "forbiddenInferences": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "productStructure": { "type": ["object", "null"] },
    "capabilityBindings": { "type": "array" },
    "nativeCanary": {
      "type": "object",
      "required": ["waveId", "primaryScreenId", "keyFlowScreenIds", "screenIds", "outcome", "supportingScreenIds"],
      "properties": {
        "waveId": { "const": "vertical-slice" },
        "primaryScreenId": { "type": "string" },
        "keyFlowScreenIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "screenIds": { "type": "array", "minItems": 2, "items": { "type": "string" }, "uniqueItems": true },
        "outcome": { "type": "string", "minLength": 10 },
        "supportingScreenIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "journey": { "type": "object", "required": ["journeyId", "journeyKind", "primaryOutcome", "entryPoints", "resume", "stages", "completionGuards", "actions", "stateActions", "signatureComponents", "continuityKeys", "scenarios", "capabilityComposition"] },
    "design": { "type": "object", "required": ["tokensPath", "recipe", "primitives"] },
    "shell": {
      "type": "object",
      "required": ["safeAreaOwner", "rootSafeAreaProviderOnly", "headerModes"],
      "properties": {
        "safeAreaOwner": { "const": "screen" },
        "rootSafeAreaProviderOnly": { "const": true },
        "headerModes": { "type": "object" }
      }
    },
    "navigation": { "type": "object", "required": ["contractRevision", "shellFingerprint", "model", "initialDestinationId", "destinations", "flows", "globalRoutePolicy", "adaptivePresentation", "accessibility", "initialRoute", "keyFlowRoute", "routes", "criticalFlow"] },
    "execution": {
      "type": "object",
      "required": ["requirementIds", "nativeCapabilities", "javascriptDependencies", "connectorOperations"],
      "properties": {
        "requirementIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "nativeCapabilities": { "type": "array", "items": { "type": "object", "required": ["id", "capability", "execution"] } },
        "javascriptDependencies": { "type": "array" },
        "connectorOperations": { "type": "array" }
      },
      "additionalProperties": false
    },
    "fixtures": {
      "type": "object",
      "required": ["adapter", "entities", "assetPolicy", "domainModelPath", "dataModule", "mediaAdapter", "assetManifest", "recordIdentity", "mediaPolicy", "mediaManifest", "mediaFields", "journeyScenarios"],
      "properties": {
        "entities": { "type": "array" },
        "domainModelPath": { "const": ".tmp/prototype-domain-model.json" },
        "dataModule": { "const": "src/data/index.ts" },
        "mediaAdapter": { "const": "src/data/media.ts" },
        "assetManifest": { "const": "assets/experience/manifest.json" },
        "recordIdentity": { "const": "stable-primary-key" },
        "mediaPolicy": { "enum": ["local-first", "remote-cdn-cached", "remote-allowed", "not-applicable"] },
        "mediaManifest": { "const": "assets/experience/manifest.json" },
        "mediaFields": { "const": ["imageUrl", "imageAltText", "imageCacheKey", "imageAssetKey"] },
        "journeyScenarios": { "type": "array", "minItems": 1 }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "route", "file", "role", "productRole", "routeParameters", "navigation", "headerMode", "header", "purpose", "presentation", "regions", "firstViewport", "context", "signatureComponent", "primaryAction", "media", "states", "qualityCriteria", "dependencies", "testIds", "forbiddenDefaults", "data", "journey", "actionState", "signatureComponents", "semanticColorRoles", "capabilityComposition", "layoutBudgets"],
        "properties": {
          "role": { "enum": ["primary", "key-flow", "supporting"] },
          "productRole": { "enum": ["primary-hub", "durable-destination", "workflow-step", "detail", "capture-surface", "transient", "modal", "immersive-utility"] },
          "routeParameters": { "type": "array" },
          "navigation": { "type": "object", "required": ["kind", "intent"] },
          "headerMode": { "enum": ["root", "back", "close", "none"] },
          "presentation": { "type": "object", "required": ["pattern", "density", "hierarchy"] },
          "regions": { "type": "array", "minItems": 1 },
          "firstViewport": {
            "type": "object",
            "required": ["regionIds", "focalPoint", "maxRegions", "visiblePrimaryAction", "primaryActionPlacement", "nextContentVisible", "maxFeatureViewportShare"],
            "properties": {
              "visiblePrimaryAction": { "type": "boolean" },
              "primaryActionPlacement": { "enum": ["inline", "sticky-bottom", "header", "floating", "none"] },
              "nextContentVisible": { "type": "boolean" },
              "maxFeatureViewportShare": { "type": "number", "minimum": 0, "maximum": 0.6 }
            }
          },
          "context": {
            "type": "object",
            "required": ["placementIntent", "entries", "assumptions", "forbiddenInferences"],
            "properties": {
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "sampleValue", "source", "placementIntent", "assumption", "testId"],
                  "properties": { "testId": { "type": "string", "pattern": "^experience-context-[a-z][a-z0-9-]*$" } }
                }
              }
            }
          },
          "signatureComponent": { "type": "object", "required": ["kind", "required", "testId"] },
          "primaryAction": { "type": ["object", "null"] },
          "media": {
            "type": "object",
            "required": ["required", "role", "aspectRatio", "minCoverage", "fallback", "prominence", "source", "delivery", "sizing", "maxViewportShare"],
            "properties": {
              "sizing": { "enum": ["responsive-clamped", "responsive-aspect", "not-applicable"] },
              "prominence": { "enum": ["none", "low", "medium", "high"] },
              "maxViewportShare": { "type": "number", "minimum": 0, "maximum": 0.8 }
            }
          },
          "states": { "type": "array", "minItems": 4 },
          "qualityCriteria": { "type": "array", "minItems": 3 },
          "dependencies": { "type": "object", "required": ["foundation", "fixtures", "screens", "artifacts"] },
          "testIds": { "type": "array", "minItems": 1 },
          "forbiddenDefaults": { "type": "array" },
          "journey": { "type": "object", "required": ["journeyId", "journeyKind", "stageId", "stageOrder", "visibleStages", "completionRuleIds", "resumeBehavior", "continuityBindings"] },
          "actionState": { "type": "object", "required": ["primaryActionId", "stateActions", "guardedActions"] },
          "signatureComponents": { "type": "array" },
          "semanticColorRoles": { "type": "array", "minItems": 6 },
          "capabilityComposition": { "type": "array" },
          "layoutBudgets": { "type": "object", "required": ["maxFocalViewportShare", "requiredFirstViewportRegions", "requireJourneyContext", "maxReservedFooterShare", "stickySurfaceOrder"] },
          "data": {
            "type": "object",
            "required": ["adapter", "entities", "fixtureScenarios", "sourceModule", "domainModel", "hooks", "recordIdentity", "mediaPolicy", "mediaFields", "operations", "runtimeBindings"],
            "properties": {
              "entities": { "type": "array" },
              "fixtureScenarios": { "type": "array" },
              "sourceModule": { "const": "@/data" },
              "domainModel": { "const": ".tmp/prototype-domain-model.json" },
              "hooks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "recordIdentity": { "const": "stable-primary-key" },
              "mediaFields": { "const": ["imageUrl", "imageAltText", "imageCacheKey", "imageAssetKey"] },
              "operations": { "type": "array" },
              "runtimeBindings": {
                "type": "object",
                "required": ["canonicalRecord", "availability", "relatedMedia", "aggregateFreshness"],
                "properties": {
                  "canonicalRecord": {
                    "type": "object",
                    "required": ["mapper", "stableId"],
                    "properties": {
                      "mapper": { "const": "domain-record" },
                      "stableId": { "const": "id" }
                    },
                    "additionalProperties": false
                  },
                  "availability": {
                    "type": "object",
                    "required": ["required", "entities", "stateProperty", "predicate", "disabledActionId"],
                    "properties": {
                      "required": { "type": "boolean" },
                      "entities": { "type": "array" },
                      "stateProperty": { "const": "availabilityState" },
                      "predicate": { "const": "isDomainRecordActionable" },
                      "disabledActionId": { "type": ["string", "null"] }
                    },
                    "additionalProperties": false
                  },
                  "relatedMedia": {
                    "type": "object",
                    "required": ["required", "resolver", "join", "relationships"],
                    "properties": {
                      "required": { "type": "boolean" },
                      "resolver": { "const": "resolveDomainMedia" },
                      "join": { "const": "repository-relationship" },
                      "relationships": { "type": "array" }
                    },
                    "additionalProperties": false
                  },
                  "aggregateFreshness": {
                    "type": "object",
                    "required": ["requiredWhenRendered", "entities", "policy", "hook"],
                    "properties": {
                      "requiredWhenRendered": { "type": "boolean" },
                      "entities": { "type": "array" },
                      "policy": { "const": "focus-revalidate-after-mutation" },
                      "hook": { "const": "useFocusEffect" }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "builderWaves": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "kind", "targets", "maxConcurrency", "dependsOn", "gates"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["foundation", "screen"] },
          "targets": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 5 },
          "dependsOn": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "gates": { "type": "array", "items": { "enum": ["typecheck", "static-quality-review"] }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "buildOrder": { "type": "array", "minItems": 3 },
    "invalidation": { "type": "object", "required": ["screenDependencies", "fixtureDependencies", "validatorDependencies"] }
  },
  "additionalProperties": false
}
