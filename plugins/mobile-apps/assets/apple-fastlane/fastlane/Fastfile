require_relative "lib/apple_preflight"
require "json"
require "open3"
require "tmpdir"
require "fileutils"
require "time"

require_relative "lib/apple_identifier"
require_relative "lib/apple_certificates"
require_relative "lib/apple_profiles"

default_platform(:ios)

class ApplePortalStageError < StandardError
  attr_reader :code

  def initialize(code)
    @code = code
    super(code)
  end
end

module ApplePortalRuntime
  module_function

  def with_stage(code)
    yield
  rescue Spaceship::ProgramLicenseAgreementUpdated,
         Spaceship::InsufficientPermissions,
         Spaceship::InvalidUserCredentialsError,
         Spaceship::NoUserCredentialsError
    raise
  rescue StandardError
    raise ApplePortalStageError, code
  end

  def safe_preflight_runtime_code(error)
    case error
    when NoMethodError then "preflight-no-method"
    when NameError then "preflight-name-error"
    when TypeError then "preflight-type-error"
    when SystemCallError, IOError then "preflight-file-error"
    else "preflight-runtime"
    end
  end

  def authenticated_portal
    require "spaceship"
    require "logger"

    # Authentication belongs to fastlane's interactive terminal. The specialized
    # client refuses cached sessions and avoids Spaceship's temporary request/service-
    # key files, keeping account/session diagnostics out of captured or persistent logs.
    interactive_client = Class.new(Spaceship::PortalClient) do
      def has_valid_session
        false
      end

      def store_cookie(path: nil)
        true
      end

      def itc_service_key
        return @service_key unless @service_key.to_s.empty?

        response = request(
          :get,
          "https://appstoreconnect.apple.com/olympus/v1/app/config" \
          "?hostname=itunesconnect.apple.com"
        )
        @service_key = response.body["authServiceKey"].to_s
        raise Spaceship::AppleTimeoutError, "Apple authentication service is unavailable." if @service_key.empty?

        @service_key
      end
    end

    portal = with_stage("portal-client-initialization") { interactive_client.new }
    portal.logger = Logger.new(File::NULL)
    apple_id = UI.input("Apple ID (enter only in this terminal):")
    apple_password = UI.password("Apple password (hidden terminal prompt):")
    with_stage("authentication-service") do
      portal.login(apple_id, apple_password)
    end
    apple_id = nil
    apple_password = nil
    portal
  end
end

class ApplePortalPreflightAdapter
  def probe(team_id:, bundle_id:)
    portal = ApplePortalRuntime.authenticated_portal
    team_found = ApplePortalRuntime.with_stage("team-access-service") do
      portal.teams.any? { |team| team["teamId"] == team_id }
    end
    return { team_found: false } unless team_found

    portal.team_id = team_id
    pending = ApplePortalRuntime.with_stage("agreements-read-service") do
      portal.list_pending_agreements
    end

    # These read-only list operations prove access to all three Certificates,
    # Identifiers & Profiles surfaces without downloading signing assets or profiles.
    apps = ApplePortalRuntime.with_stage("identifiers-read-service") do
      portal.apps(mac: false)
    end
    certificate_types = ApplePortalRuntime.with_stage("certificates-response-processing") do
      Spaceship::Portal::Certificate::APPLE_CERTIFICATE_TYPE_IDS.keys +
        Spaceship::Portal::Certificate::IOS_CERTIFICATE_TYPE_IDS.keys
    end
    ApplePortalRuntime.with_stage("certificates-read-service") do
      portal.certificates(certificate_types.uniq, mac: false)
    end
    ApplePortalRuntime.with_stage("profiles-read-service") do
      portal.provisioning_profiles(mac: false)
    end

    pending_agreements = ApplePortalRuntime.with_stage("agreements-response-processing") do
      MobileAppApplePreflight.pending_agreements?(pending)
    end
    identifier_present = ApplePortalRuntime.with_stage("identifiers-response-processing") do
      apps.any? { |app| app["identifier"] == bundle_id }
    end

    {
      team_found: true,
      pending_agreements: pending_agreements,
      identifiers_readable: true,
      certificates_readable: true,
      profiles_readable: true,
      identifier_present: identifier_present
    }
  end
end

class ApplePortalIdentifierAdapter
  def initialize
    @portal = ApplePortalRuntime.authenticated_portal
  end
end

class ApplePortalCertificateAdapter
    MODERN_TYPES = {
      "apple-development" => "Development",
      "apple-distribution" => "Distribution"
    }.freeze

    def initialize(keychain_path:, certificate_action:, portal: nil)
      @portal = portal || ApplePortalRuntime.authenticated_portal
      @keychain_path = keychain_path
      @certificate_action = certificate_action
    end

end

class ApplePortalProfileAdapter
      def initialize(keychain_path:, profile_action:, portal: nil, xcode_version: nil)
        @portal = portal || ApplePortalRuntime.authenticated_portal
        @keychain_path = keychain_path.to_s
        @profile_action = profile_action
        @xcode_version = xcode_version
        @staging_directories = []
        @certificate_by_serial = {}
      end

      def inspect_state(team_id:, bundle_id:)
        require "openssl"

        teams = @portal.teams
        return { team_found: false } unless teams.any? { |team| team["teamId"] == team_id }

        @portal.team_id = team_id
        pending = @portal.list_pending_agreements
        certificates = @portal.certificates(
          Spaceship::Portal::Certificate::APPLE_CERTIFICATE_TYPE_IDS.keys,
          mac: false
        )
        @certificate_by_serial = certificates.filter_map do |raw|
          type = normalized_certificate_type(raw)
          next unless type

          serial = normalized_serial(profile_value(raw, :serial_number, "serialNumber"))
          [serial, {
            resource_id: profile_value(raw, :id, "certificateId", "id").to_s,
            type: type
          }]
        end.to_h

        # PortalClient#devices sends the currently selected Developer Portal
        # team ID with every request. Do not use the process-global ConnectAPI
        # client here: the lane authenticated this exact PortalClient session.
        devices = @portal.devices(mac: false, include_disabled: true)
        ios_devices = devices.select { |device| ios_device?(device) }
        enabled = ios_devices.count { |device| device_enabled?(device) }
        enabled_ids = ios_devices
          .select { |device| device_enabled?(device) }
          .map { |device| profile_value(device, :udid, "deviceNumber", "udid").to_s }
        {
          team_found: true,
          pending_agreements: MobileAppApplePreflight.pending_agreements?(pending),
          profiles_readable: true,
          registered_device_count: ios_devices.length,
          enabled_device_count: enabled,
          # Only an in-memory digest crosses into the verifier. Neither the device
          # inventory nor individual UDIDs are logged, persisted, or returned.
          enabled_device_digest: MobileAppAppleProfiles.device_digest(enabled_ids)
        }
      end

      def obtain_profile(team_id:, bundle_id:, type:, certificate:, force:)
        raise MobileAppAppleProfiles::ProfileUnavailable if @keychain_path.empty?

        staging = MobileAppAppleCertificates.with_private_staging do |directory|
          # Keep the staging directory alive until installation/read-back completes;
          # the adapter owns cleanup rather than the certificate helper's block.
          retained = "#{directory}-profiles"
          File.rename(directory, retained)
          @staging_directories << retained
          retained
        end
        filename = type == "development" ? "development.mobileprovision" : "ad-hoc.mobileprovision"
        profile_name = "Power Platform Skills #{bundle_id} #{type == "development" ? "Development" : "Ad Hoc"}"
        parameters = {
          app_identifier: bundle_id,
          team_id: team_id,
          provisioning_name: profile_name,
          cert_id: certificate.fetch("resourceId"),
          development: type == "development",
          adhoc: type == "ad-hoc",
          readonly: !force,
          force: force,
          skip_install: true,
          output_path: staging,
          filename: filename
        }
        path = with_sensitive_certificate_action_ui { @profile_action.call(parameters) }
        candidate = path.to_s.empty? ? File.join(staging, filename) : path.to_s
        raise MobileAppAppleProfiles::ProfileUnavailable unless File.file?(candidate) && !File.symlink?(candidate)

        {
          source_path: candidate,
          metadata: decode_profile(candidate)
        }
      rescue MobileAppAppleProfiles::ProfileUnavailable
        raise
      rescue StandardError
        # Sigh can include account identity, profile names, certificate hashes, and
        # device identifiers in diagnostics. Collapse all failures to a safe category.
        raise MobileAppAppleProfiles::ProfileUnavailable
      end

      def install_profile(profile)
        source = profile.fetch(:source_path)
        metadata = profile.fetch(:metadata)
        uuid = metadata.fetch(:uuid)
        raise MobileAppAppleProfiles::InstallFailed unless MobileAppAppleProfiles::UUID.match?(uuid)

        directory = provisioning_profiles_directory
        assert_standard_profile_directory!(directory)
        FileUtils.mkdir_p(directory, mode: 0o700)
        assert_standard_profile_directory!(directory)
        destination = File.join(directory, "#{uuid}.mobileprovision")
        temporary = File.join(directory, ".#{uuid}.#{Process.pid}.installing")
        raise MobileAppAppleProfiles::InstallFailed if File.symlink?(destination)

        File.open(temporary, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |output|
          File.open(source, File::RDONLY) { |input| IO.copy_stream(input, output) }
          output.flush
          output.fsync
        end
        File.rename(temporary, destination)
        decode_profile(destination)
      rescue StandardError
        FileUtils.rm_f(temporary) if defined?(temporary) && temporary
        raise MobileAppAppleProfiles::InstallFailed
      end

      def cleanup!
        @staging_directories.each do |directory|
          basename = File.basename(directory)
          FileUtils.rm_rf(directory) if basename.start_with?("mobile-app-apple-certificates-") &&
                                        basename.end_with?("-profiles")
        end
        @staging_directories.clear
      end

      private

      def decode_profile(path)
        require "openssl"
        require "plist"

        xml, _error, status = Open3.capture3("/usr/bin/security", "cms", "-D", "-i", path)
        raise MobileAppAppleProfiles::ProfileUnavailable unless status.success?
        plist = Plist.parse_xml(xml)
        MobileAppAppleProfiles.metadata_from_plist(
          plist,
          certificate_resolver: lambda do |certificate_data|
            certificate = OpenSSL::X509::Certificate.new(certificate_data)
            @certificate_by_serial[normalized_serial(certificate.serial.to_s(16))]
          rescue OpenSSL::X509::CertificateError
            nil
          end
        )
      ensure
        # Decoded XML contains device identifiers and certificate bytes. It remains
        # process-local and is discarded without logging or writing another file.
        xml = nil
        plist = nil
      end

      def profile_value(raw, *keys)
        keys.each do |key|
          return raw.public_send(key) if key.is_a?(Symbol) && raw.respond_to?(key)
          return raw[key] if raw.respond_to?(:key?) && raw.key?(key)
        end
        nil
      end

      def normalized_certificate_type(raw)
        value = profile_value(raw, :type, "certificateType", "typeDisplayId").to_s.downcase
        return "apple-development" if value.include?("development")
        return "apple-distribution" if value.include?("distribution")

        nil
      end

      def normalized_serial(serial)
        serial.to_s.delete(":").sub(/\A0+/, "").upcase
      end

      def ios_device?(device)
        # PortalClient#devices returns raw hashes such as:
        #   { "devicePlatform"=>"ios", "deviceClass"=>"iphone", "status"=>"c" }
        # where c=enabled and r=disabled in pinned Fastlane 2.238.0.
        # See: https://github.com/fastlane/fastlane/blob/2.238.0/spaceship/lib/spaceship/portal/device.rb
        platform = profile_value(device, :platform, "devicePlatform", "platform")
        device_class = profile_value(
          device,
          :device_type,
          :device_class,
          "deviceClass"
        )
        return platform.to_s.casecmp("IOS").zero? unless platform.to_s.empty?
        return true if device_class.to_s.empty?

        %w[iphone ipad ipod].include?(device_class.to_s.downcase)
      end

      def device_enabled?(device)
        enabled = profile_value(device, :enabled, "enabled")
        return enabled if enabled == true || enabled == false

        %w[c enabled].include?(
          profile_value(device, :status, "status").to_s.downcase
        )
      end

      def provisioning_profiles_directory
        helper = File.expand_path("lib/apple_profile_directory.js", __dir__)
        command = ["node", helper]
        command.concat(["--xcode-version", @xcode_version.to_s]) if @xcode_version
        stdout, _stderr, status = Open3.capture3(*command)
        result = JSON.parse(stdout)
        raise MobileAppAppleProfiles::InstallFailed unless status.success?
        raise MobileAppAppleProfiles::InstallFailed unless result["status"] == "ready"

        result.fetch("directory")
      rescue JSON::ParserError, KeyError
        raise MobileAppAppleProfiles::InstallFailed
      end

      def assert_standard_profile_directory!(directory)
        home = File.realpath(File.expand_path("~"))
        current = home
        File.expand_path(directory).delete_prefix("#{home}/").split("/").each do |component|
          current = File.join(current, component)
          next unless File.exist?(current) || File.symlink?(current)

          raise MobileAppAppleProfiles::InstallFailed if File.symlink?(current)
        end
      end
    end

class ApplePortalCertificateAdapter
    def inspect_state(team_id:)
      require "openssl"

      teams = @portal.teams
      return { team_found: false } unless teams.any? { |team| team["teamId"] == team_id }

      @portal.team_id = team_id
      pending = @portal.list_pending_agreements
      remote = @portal.certificates(
        Spaceship::Portal::Certificate::APPLE_CERTIFICATE_TYPE_IDS.keys,
        mac: false
      )
      local = local_identities(team_id)
      certificates = remote.filter_map do |raw|
        type = normalized_type(raw)
        next unless type

        serial = normalized_serial(value(raw, :serial_number, "serialNumber"))
        identity = local.find { |entry| entry[:serial] == serial && entry[:type] == type }
        {
          resource_id: value(raw, :id, "certificateId", "id"),
          type: type,
          expires_at: Time.parse(value(raw, :expires, "expirationDate", "dateExpire").to_s),
          usable: !identity.nil?
        }
      end
      {
        team_found: true,
        pending_agreements: MobileAppApplePreflight.pending_agreements?(pending),
        certificates_readable: true,
        certificates: certificates
      }
    end

    def create_certificate(team_id:, type:, renew:)
      keychain_path = @keychain_path.to_s
      raise MobileAppAppleCertificates::ImportFailed if keychain_path.empty?

      MobileAppAppleCertificates.with_private_staging do |staging|
        with_sensitive_certificate_action_ui do
          @certificate_action.call(
            development: type == "apple-development",
            generate_apple_certs: true,
            # Pinned fastlane 2.238.0 `cert` skips its existing-certificate
            # lookup when force is true and creates a replacement; it does not
            # revoke. This is permitted only for an explicitly confirmed renewal.
            # See: https://github.com/fastlane/fastlane/blob/2.238.0/cert/lib/cert/runner.rb
            force: renew,
            team_id: team_id,
            output_path: staging,
            keychain_path: keychain_path
          )
        end
      end
    rescue StandardError => error
      # Raw Fastlane and `security` diagnostics can contain certificate names,
      # hashes, keychain paths, and signing commands. Classify without relaying.
      message = error.message.to_s.downcase
      if message.include?("maximum") || message.include?("quota") || message.include?("too many")
        raise MobileAppAppleCertificates::QuotaExhausted
      end
      raise MobileAppAppleCertificates::ImportFailed
    end

    private

    def value(raw, *keys)
      keys.each do |key|
        return raw.public_send(key) if key.is_a?(Symbol) && raw.respond_to?(key)
        return raw[key] if raw.respond_to?(:key?) && raw.key?(key)
      end
      nil
    end

    def normalized_type(raw)
      value = value(raw, :type, "certificateType", "typeDisplayId").to_s.downcase
      return "apple-development" if value.include?("development")
      return "apple-distribution" if value.include?("distribution")

      nil
    end

    def normalized_serial(serial)
      serial.to_s.delete(":").sub(/\A0+/, "").upcase
    end

    def local_identities(team_id)
      require "openssl"

      keychain_path = @keychain_path.to_s
      raise MobileAppAppleCertificates::ImportFailed if keychain_path.empty?
      identity_output, _identity_error, identity_status =
        Open3.capture3("/usr/bin/security", "find-identity", "-v", "-p", "codesigning", keychain_path)
      raise MobileAppAppleCertificates::ImportFailed unless identity_status.success?

      identity_hashes = identity_output.scan(/\b[0-9A-F]{40}\b/i).map(&:upcase)
      pem_output, _pem_error, pem_status =
        Open3.capture3("/usr/bin/security", "find-certificate", "-a", "-p", keychain_path)
      raise MobileAppAppleCertificates::ImportFailed unless pem_status.success?

      pem_output.scan(/-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----/m).filter_map do |pem|
        certificate = OpenSSL::X509::Certificate.new(pem)
        subject = certificate.subject.to_a.to_h { |name, data, _| [name, data] }
        next unless subject["OU"] == team_id

        common_name = subject["CN"].to_s
        type =
          if common_name.start_with?("Apple Development")
            "apple-development"
          elsif common_name.start_with?("Apple Distribution")
            "apple-distribution"
          end
        next unless type
        fingerprint = OpenSSL::Digest::SHA1.hexdigest(certificate.to_der).upcase
        next unless identity_hashes.include?(fingerprint)

        {
          serial: normalized_serial(certificate.serial.to_s(16)),
          type: type,
          expires_at: certificate.not_after.utc
        }
      end
    end
end

class ApplePortalIdentifierAdapter
  def inspect_state(team_id:, bundle_id:)
    teams = @portal.teams
    return { team_found: false } unless teams.any? { |team| team["teamId"] == team_id }

    selected_exact = nil
    other_team_exact = []
    wildcard_conflicts = []
    case_conflicts = []
    identifiers_readable = true
    pending_agreements = false

    teams.each do |team|
      current_team = team["teamId"]
      @portal.team_id = current_team
      if current_team == team_id
        pending_agreements = MobileAppApplePreflight.pending_agreements?(
          @portal.list_pending_agreements
        )
      end

      @portal.apps(mac: false).each do |raw|
        identifier = raw["identifier"].to_s
        wildcard = raw["isWildCard"] == true || identifier.end_with?("*")
        if wildcard && wildcard_matches?(identifier, bundle_id)
          wildcard_conflicts << { team_id: current_team }
        elsif identifier.casecmp(bundle_id).zero?
          if identifier != bundle_id
            case_conflicts << { team_id: current_team }
          elsif current_team == team_id
            selected_exact = normalize_app(raw, current_team)
          else
            other_team_exact << { team_id: current_team }
          end
        end
      end
    rescue Spaceship::InsufficientPermissions
      identifiers_readable = false
    ensure
      @portal.team_id = team_id
    end

    {
      team_found: true,
      pending_agreements: pending_agreements,
      identifiers_readable: identifiers_readable,
      selected_exact: selected_exact,
      other_team_exact: other_team_exact,
      wildcard_conflicts: wildcard_conflicts,
      case_conflicts: case_conflicts
    }
  end

  def create_explicit_identifier(team_id:, bundle_id:, app_name:)
    @portal.team_id = team_id
    # This is the same Developer Portal App ID primitive used by produce, but it
    # deliberately omits Produce::ItunesConnect so no ASC app/listing is created.
    @portal.create_app!(:explicit, app_name, bundle_id, mac: false, enable_services: {})
  end

  def enable_push(team_id:, bundle_id:)
    @portal.team_id = team_id
    raw = @portal.apps(mac: false).find { |app| app["identifier"] == bundle_id }
    raise MobileAppAppleIdentifier::Blocked, "identifier-readback-failed" unless raw

    app = Spaceship::Portal::App.new(raw)
    @portal.update_service_for_app(
      app,
      Spaceship::Portal::AppService::PushNotification.on
    )
  end

  private

  def wildcard_matches?(wildcard_identifier, bundle_id)
    bundle_id.start_with?(wildcard_identifier.delete_suffix("*"))
  end

  def normalize_app(raw, team_id)
    app = Spaceship::Portal::App.new(raw)
    details = @portal.details_for_app(app)
    enabled = details["isDevPushEnabled"] == true &&
      details["isProdPushEnabled"] == true
    enabled ||= Array(details["enabledFeatures"]).any? do |feature|
      feature == "push" || (feature.is_a?(Hash) && feature["featureType"] == "push")
    end

    {
      resource_id: details["appIdId"] || raw["appIdId"],
      team_id: team_id,
      platform: details["appIdPlatform"] || raw["appIdPlatform"] || "ios",
      explicit: details["isWildCard"] != true && !raw["identifier"].to_s.end_with?("*"),
      push_enabled: enabled
    }
  end
end

def reject_external_apple_credentials!
  forbidden = %w[
    FASTLANE_USER FASTLANE_PASSWORD FASTLANE_SESSION SPACESHIP_SESSION DELIVER_PASSWORD
    SPACESHIP_2FA_SMS_DEFAULT_PHONE_NUMBER SPACESHIP_COOKIE
    SPACESHIP_DEBUG FASTLANE_VERBOSE VERBOSE DEBUG
  ].select { |name| !ENV[name].to_s.empty? }
  return if forbidden.empty?

  UI.user_error!(
    "Apple preflight requires interactive Apple ID and 2FA prompts. " \
    "Unset credential/session environment variables before retrying."
  )
end

def reserved_lane!(lane_name)
  UI.user_error!(
    "#{lane_name} is reserved by the mobile-app Apple provisioning workflow " \
    "and is not implemented by the scaffold."
  )
end

def validate_device_team!(team_id)
  UI.user_error!("APPLE_DEVICE_REGISTRATION_BLOCKED=team-id-invalid") unless team_id.to_s.match?(/\A[A-Z0-9]{10}\z/)
  preflight_path = File.expand_path("../apple-ios-preflight.json", __dir__)
  UI.user_error!("APPLE_DEVICE_REGISTRATION_BLOCKED=preflight-required") unless File.file?(preflight_path)

  proof = JSON.parse(File.read(preflight_path))
  UI.user_error!("APPLE_DEVICE_REGISTRATION_BLOCKED=wrong-team") unless proof["teamId"] == team_id
  valid_until = Time.iso8601(proof.dig("proof", "validUntil").to_s)
  unless proof["status"] == "ready" &&
         valid_until > Time.now.utc &&
         proof.dig("authentication", "teamMembership") == "verified" &&
         %w[certificates identifiers profiles].all? { |key| proof.dig("permissions", key) == true }
    UI.user_error!("APPLE_DEVICE_REGISTRATION_BLOCKED=preflight-invalid")
  end
rescue JSON::ParserError, ArgumentError
  UI.user_error!("APPLE_DEVICE_REGISTRATION_BLOCKED=preflight-malformed")
end

def prepare_device_file(input_path: nil, records: nil)
  converter = File.expand_path("lib/apple_device_input.js", __dir__)
  command = ["node", converter]
  stdin_data = nil
  if records
    command << "--stdin-json"
    stdin_data = JSON.generate(records)
  else
    command.concat(["--input", input_path])
  end

  stdout, _stderr, status = Open3.capture3(*command, stdin_data: stdin_data)
  result = JSON.parse(stdout)
  unless status.success?
    UI.user_error!("APPLE_DEVICE_REGISTRATION_BLOCKED=#{result["reason"] || "input-processing-failed"}")
  end
  result
rescue JSON::ParserError
  UI.user_error!("APPLE_DEVICE_REGISTRATION_BLOCKED=input-processing-failed")
end

def cleanup_device_file(prepared)
  return unless prepared && prepared["directory"]

  # The converter creates a unique mode-0700 directory in the OS external temp
  # root. Refuse to broaden cleanup if its returned path shape is ever changed.
  directory = File.realpath(prepared["directory"])
  prefix = File.join(File.realpath(Dir.tmpdir), "mobile-app-apple-devices-")
  FileUtils.rm_rf(directory) if directory.start_with?(prefix)
rescue Errno::ENOENT
  nil
end

class SensitiveAppleDeviceActionUi
  def initialize(delegate)
    @delegate = delegate
  end

  # Device action failures and verbose "already exists" messages contain full
  # UDIDs. Suppress every action-owned output channel while preserving only the
  # terminal interactions needed by Fastlane's own authentication flow.
  %i[error important success message deprecated command command_output verbose header content_error].each do |method|
    define_method(method) { |*| nil }
  end

  %i[interactive? input confirm select password].each do |method|
    define_method(method) { |*args| @delegate.public_send(method, *args) }
  end

  %i[crash! user_error! shell_error! build_failure! test_failure! abort_with_message!].each do |method|
    define_method(method) { |*args| @delegate.public_send(method, *args) }
  end
end

def with_sensitive_device_action_ui
  original = FastlaneCore::UI.ui_object
  FastlaneCore::UI.ui_object = SensitiveAppleDeviceActionUi.new(original)
  yield
ensure
  FastlaneCore::UI.ui_object = original
end

def with_sensitive_certificate_action_ui
  original = FastlaneCore::UI.ui_object
  FastlaneCore::UI.ui_object = SensitiveAppleDeviceActionUi.new(original)
  yield
ensure
  FastlaneCore::UI.ui_object = original
end

def normalized_device_udid(value)
  value.to_s.delete("-").upcase
end

def device_enabled?(device)
  return device.enabled if device.respond_to?(:enabled)
  return device.status.to_s.casecmp("ENABLED").zero? if device.respond_to?(:status)

  false
end

def verify_registered_devices!(prepared)
  require "spaceship"
  requested = File.readlines(prepared.fetch("file"), chomp: true).drop(1).filter_map do |line|
    next if line.empty?
    udid, name, platform = line.split("\t", 3)
    { udid: normalized_device_udid(udid), name: name, platform: platform }
  end
  devices = Spaceship::ConnectAPI::Device.all
  matched = requested.filter_map do |requested_device|
    devices.find do |device|
      normalized_device_udid(device.udid) == requested_device[:udid]
    end
  end

  UI.user_error!("APPLE_DEVICE_REGISTRATION_BLOCKED=readback-count-mismatch") unless matched.length == requested.length
  UI.user_error!("APPLE_DEVICE_REGISTRATION_BLOCKED=disabled-device") unless matched.all? { |device| device_enabled?(device) }
  matched.each do |device|
    requested_device = requested.find { |entry| entry[:udid] == normalized_device_udid(device.udid) }
    if device.respond_to?(:name) && device.name.to_s != requested_device[:name]
      UI.user_error!("APPLE_DEVICE_REGISTRATION_BLOCKED=duplicate-udid-conflict")
    end
  end
  requested.each do |requested_device|
    conflict = devices.any? do |device|
      device.respond_to?(:name) &&
        device.name.to_s.casecmp(requested_device[:name]).zero? &&
        normalized_device_udid(device.udid) != requested_device[:udid]
    end
    UI.user_error!("APPLE_DEVICE_REGISTRATION_BLOCKED=duplicate-name-conflict") if conflict
  end

  # Full device identifiers and inventory are intentionally never returned.
  { matched_count: matched.length, enabled: true }
end

def register_prepared_devices!(prepared, team_id, single:)
  summary = "count=#{prepared.fetch("count")} " \
            "platforms=#{prepared.fetch("platformCounts").map { |key, value| "#{key}:#{value}" }.join(",")} " \
            "suffixes=#{prepared.fetch("maskedSuffixes").join(",")}"
  confirmed = UI.confirm("Register Apple development devices? #{summary}")
  unless confirmed
    reason = single ? "single-unconfirmed" : "batch-unconfirmed"
    UI.user_error!("APPLE_DEVICE_REGISTRATION_BLOCKED=#{reason}")
  end

  begin
    if single
      row = File.readlines(prepared.fetch("file"), chomp: true).fetch(1).split("\t", 3)
      with_sensitive_device_action_ui do
        register_device(name: row[1], udid: row[0], platform: row[2], team_id: team_id)
      end
    else
      with_sensitive_device_action_ui do
        register_devices(devices_file: prepared.fetch("file"), platform: "ios", team_id: team_id)
      end
    end

  rescue StandardError
    # Fastlane device-action errors can include the full UDID. Discard them and
    # return only a stable category so terminal capture cannot disclose it.
    UI.user_error!("APPLE_DEVICE_REGISTRATION_BLOCKED=device-limit-or-registration-failed")
  end
  verify_registered_devices!(prepared)
end

desc "Authenticate and verify Apple team access, permissions, and agreements"
lane :apple_preflight do |options|
  reject_external_apple_credentials!
  UI.user_error!("Apple preflight must run in an interactive terminal.") unless $stdin.tty?

  begin
    result = MobileAppApplePreflight.run(
      team_id: options[:team_id],
      bundle_id: options[:bundle_id],
      refresh: options[:refresh],
      adapter: ApplePortalPreflightAdapter.new,
      output_path: File.expand_path("../apple-ios-preflight.json", __dir__)
    )
    UI.success(
      "APPLE_PREFLIGHT_STATUS=#{result.fetch("status")} " \
      "TEAM_ID=#{result.fetch("teamId")} BUNDLE_ID=#{result.fetch("bundleId")} " \
      "IDENTIFIER=#{result.dig("identifier", "status")}"
    )
  rescue MobileAppApplePreflight::Blocked => error
    UI.user_error!("APPLE_PREFLIGHT_BLOCKED=#{error.code}")
  rescue Spaceship::ProgramLicenseAgreementUpdated
    UI.user_error!("APPLE_PREFLIGHT_BLOCKED=agreements")
  rescue Spaceship::InsufficientPermissions
    UI.user_error!("APPLE_PREFLIGHT_BLOCKED=cip-permissions")
  rescue Spaceship::InvalidUserCredentialsError, Spaceship::NoUserCredentialsError
    UI.user_error!("APPLE_PREFLIGHT_BLOCKED=authentication")
  rescue ApplePortalStageError => error
    UI.user_error!("APPLE_PREFLIGHT_BLOCKED=#{error.code}")
  rescue StandardError => error
    # Raw Apple/Fastlane exceptions can contain account or session diagnostics.
    # Map only safe exception classes; never copy messages or backtraces.
    UI.user_error!("APPLE_PREFLIGHT_BLOCKED=#{ApplePortalRuntime.safe_preflight_runtime_code(error)}")
  end
end

desc "Create/reuse one exact iOS identifier and enable Push Notifications in Developer Portal only"
lane :ensure_identifier_capabilities do |options|
  reject_external_apple_credentials!
  UI.user_error!("Apple identifier setup must run in an interactive terminal.") unless $stdin.tty?

  begin
    result = MobileAppAppleIdentifier.run(
      team_id: options[:team_id],
      bundle_id: options[:bundle_id],
      app_name: options[:app_name],
      confirm: options[:confirm],
      refresh: options[:refresh],
      adapter: ApplePortalIdentifierAdapter.new,
      output_path: File.expand_path("../apple-ios-identifier.json", __dir__)
    )
    UI.success(JSON.generate(result))
  rescue MobileAppAppleIdentifier::Blocked => error
    UI.user_error!(JSON.generate({
      status: "blocked",
      reason: error.code,
      teamId: options[:team_id].to_s,
      bundleId: options[:bundle_id].to_s,
      mutations: error.details.fetch(:mutations, []),
      confirmationToken: error.details.fetch(
        :confirmation_token,
        MobileAppAppleIdentifier.confirmation_token(
          options[:team_id].to_s,
          options[:bundle_id].to_s
        )
      )
    }))
  rescue Spaceship::ProgramLicenseAgreementUpdated
    UI.user_error!(JSON.generate({ status: "blocked", reason: "agreements" }))
  rescue Spaceship::InsufficientPermissions
    UI.user_error!(JSON.generate({ status: "blocked", reason: "cip-permissions" }))
  rescue Spaceship::InvalidUserCredentialsError, Spaceship::NoUserCredentialsError
    UI.user_error!(JSON.generate({ status: "blocked", reason: "authentication" }))
  rescue StandardError
    # Raw Apple/Fastlane exceptions can contain account or session diagnostics.
    UI.user_error!(JSON.generate({ status: "blocked", reason: "apple-service" }))
  end
end

desc "Register one hidden-input device or a confirmed external JSON/CSV/Apple batch"
lane :register_apple_devices do
  reject_external_apple_credentials!
  UI.user_error!("Apple device registration must run in an interactive terminal.") unless $stdin.tty?
  team_id = UI.input("Approved Apple Team ID:")
  validate_device_team!(team_id)
  mode = UI.select("Device registration input", ["single", "external-batch"])
  prepared = nil

  begin
    if mode == "single"
      name = UI.input("Device display name:")
      platform = UI.select("Device platform", ["ios"])
      # UI.password masks typed characters. Never provide a UDID through lane
      # options, argv, environment variables, chat, or any persistent file.
      udid = UI.password("Device UDID (hidden terminal prompt):")
      prepared = prepare_device_file(records: [{ name: name, platform: platform, udid: udid }])
      udid = nil
      result = register_prepared_devices!(prepared, team_id, single: true)
    else
      input_path = UI.input("Absolute path to external JSON, CSV, or Apple device file:")
      prepared = prepare_device_file(input_path: input_path)
      result = register_prepared_devices!(prepared, team_id, single: false)
    end
    UI.success(
      "APPLE_DEVICE_REGISTRATION_STATUS=ready " \
      "MATCHED_COUNT=#{result.fetch(:matched_count)} ENABLED=#{result.fetch(:enabled)}"
    )
  ensure
    cleanup_device_file(prepared)
  end
end

desc "Create/reuse modern Apple development and distribution certificates"
lane :ensure_signing_certificates do |options|
  reject_external_apple_credentials!
  UI.user_error!("Apple certificate setup must run in an interactive terminal.") unless $stdin.tty?

  begin
    result = MobileAppAppleCertificates.run(
      team_id: options[:team_id],
      confirm: options[:confirm],
      refresh: options[:refresh],
      adapter: ApplePortalCertificateAdapter.new(
        keychain_path: options[:keychain_path],
        certificate_action: lambda { |parameters| cert(**parameters) }
      ),
      output_path: File.expand_path("../apple-ios-certificates.json", __dir__)
    )
    UI.success(JSON.generate(result))
  rescue MobileAppAppleCertificates::Blocked => error
    UI.user_error!(JSON.generate({
      status: "blocked",
      reason: error.code,
      teamId: options[:team_id].to_s,
      mutations: error.details.fetch(:mutations, []),
      confirmationToken: error.details.fetch(
        :confirmation_token,
        MobileAppAppleCertificates.confirmation_token(options[:team_id].to_s)
      ),
      renewalWindowDays: MobileAppAppleCertificates::RENEWAL_WINDOW_SECONDS / 86_400
    }))
  rescue Spaceship::ProgramLicenseAgreementUpdated
    UI.user_error!(JSON.generate({ status: "blocked", reason: "agreements" }))
  rescue Spaceship::InsufficientPermissions
    UI.user_error!(JSON.generate({ status: "blocked", reason: "cip-permissions" }))
  rescue Spaceship::InvalidUserCredentialsError, Spaceship::NoUserCredentialsError
    UI.user_error!(JSON.generate({ status: "blocked", reason: "authentication" }))
  rescue StandardError
    UI.user_error!(JSON.generate({ status: "blocked", reason: "apple-service" }))
  end
end

desc "Create/reuse, install, and verify exact development and ad hoc profiles"
lane :ensure_provisioning_profiles do |options|
  reject_external_apple_credentials!
  UI.user_error!("Apple profile setup must run in an interactive terminal.") unless $stdin.tty?

  adapter = ApplePortalProfileAdapter.new(
    keychain_path: options[:keychain_path],
    profile_action: lambda { |parameters| get_provisioning_profile(**parameters) }
  )
  begin
    result = MobileAppAppleProfiles.run(
      team_id: options[:team_id],
      bundle_id: options[:bundle_id],
      confirm: options[:confirm],
      refresh: options[:refresh],
      devices_changed: options[:devices_changed],
      keychain: {
        "serviceIdentifier" => options[:keychain_service_identifier].to_s,
        "pathFingerprint" => options[:keychain_path_fingerprint].to_s
      },
      identifier_path: File.expand_path("../apple-ios-identifier.json", __dir__),
      certificates_path: File.expand_path("../apple-ios-certificates.json", __dir__),
      output_path: File.expand_path("../apple-ios-provisioning.json", __dir__),
      adapter: adapter
    )
    UI.success(JSON.generate({
      status: "ready",
      teamId: result.fetch("teamId"),
      bundleId: result.fetch("bundleId"),
      profiles: result.fetch("profiles").transform_values do |profile|
        profile.slice(
          "uuid", "type", "expiresAt", "deviceCount",
          "certificateResourceId", "certificateType", "proof"
        )
      end
    }))
  rescue MobileAppAppleProfiles::Blocked => error
    UI.user_error!(JSON.generate({
      status: "blocked",
      reason: error.code,
      teamId: options[:team_id].to_s,
      bundleId: options[:bundle_id].to_s,
      deviceCount: error.details[:device_count],
      scope: error.details.fetch(:scope, []),
      reasons: error.details.fetch(:reasons, {}),
      confirmationToken: error.details[:confirmation_token]
    }.compact))
  rescue Spaceship::ProgramLicenseAgreementUpdated
    UI.user_error!(JSON.generate({ status: "blocked", reason: "agreements" }))
  rescue Spaceship::InsufficientPermissions
    UI.user_error!(JSON.generate({ status: "blocked", reason: "cip-permissions" }))
  rescue Spaceship::InvalidUserCredentialsError, Spaceship::NoUserCredentialsError
    UI.user_error!(JSON.generate({ status: "blocked", reason: "authentication" }))
  rescue StandardError
    UI.user_error!(JSON.generate({ status: "blocked", reason: "apple-service" }))
  ensure
    adapter.cleanup!
  end
end
