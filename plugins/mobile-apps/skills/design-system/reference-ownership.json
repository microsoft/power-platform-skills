      ],
      "forbiddenReferences": [
        "optional-modes.md",
        "references/input-modes.md",
        "references/figma-extraction.md",
        "references/reference-intake.md",
        "references/canvas-app-extraction.md",
        "references/code-app-extraction.md",
        "references/power-pages-extraction.md",
        "references/vibe/style-picker.md",
        "references/vibe/brand-examples.md",
        "references/preview-template.md",
        "references/refresh-flow.md"
      ]
    },
    "optional": {
      "entrypoint": "optional-modes.md",
      "owns": [
        "brand-and-logo-extraction",
        "figma-extraction",
        "screenshot-reference-intake",
