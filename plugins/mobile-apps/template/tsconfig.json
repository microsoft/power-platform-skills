{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "paths": {
      "react-native": ["./node_modules/react-native"],
      "expo-auth-session": ["./node_modules/expo-auth-session"],
      "expo-secure-store": ["./node_modules/expo-secure-store"],
      "expo-web-browser": ["./node_modules/expo-web-browser"],
      "@/components": ["./src/components"],
      "@/components/*": ["./src/components/*"],
      "@/hooks": ["./src/hooks"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/utils": ["./src/utils"],
      "@/utils/*": ["./src/utils/*"],
      "@/tokens": ["./src/tokens"],
      "@/tokens/*": ["./src/tokens/*"],
      "@/generated": ["./src/generated"],
      "@/generated/*": ["./src/generated/*"],
      "@/native": ["./src/native"],
      "@/native/*": ["./src/native/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/native-player"
  ]
}
