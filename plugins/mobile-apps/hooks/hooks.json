{
  "description": "Mobile Apps scoped write-safety hook",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const path=require('node:path'); const root=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT; if(root){require(path.resolve(root,'hooks','validate-write-safety.js'));}\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}