.{{cssClass}} {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  font-family: "Segoe UI", Arial, sans-serif;
}

.{{cssInputClass}} {
  box-sizing: border-box;
  min-height: 2rem;
  padding: 0.25rem 0.5rem;
}

.{{cssMessageClass}} {
  color: #605e5c;
  font-size: 0.875rem;
}
