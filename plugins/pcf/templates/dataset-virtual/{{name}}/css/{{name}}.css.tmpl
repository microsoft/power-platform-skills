.{{cssClass}} {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  font-family: "Segoe UI", Arial, sans-serif;
}

.{{cssClass}} table {
  border-collapse: collapse;
  width: 100%;
}

.{{cssClass}} td {
  border-bottom: 1px solid #edebe9;
  padding: 0.375rem 0.5rem;
}

.{{cssClass}} button {
  min-height: 2rem;
}

.{{nameLower}}-pager {
  display: flex;
  gap: 0.5rem;
}

.{{cssMessageClass}} {
  color: #605e5c;
  font-size: 0.875rem;
}
