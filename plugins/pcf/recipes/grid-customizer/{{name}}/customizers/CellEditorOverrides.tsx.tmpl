import * as React from "react";
import { CellEditorOverrides } from "../types";

export const cellEditorOverrides: CellEditorOverrides = {
    Text: (defaultProps, rendererParams) => {
        if (defaultProps.secured) return null;
        const label = rendererParams.colDefs[rendererParams.columnIndex]?.displayName ?? defaultProps.columnDataType ?? "Text";
        const initialValue = defaultProps.charPress ?? (defaultProps.value == null ? "" : String(defaultProps.value));
        if (defaultProps.charPress) {
            defaultProps.onChange(defaultProps.charPress);
            rendererParams.onCellValueChanged(defaultProps.charPress);
        }
        const onChange = (event: React.ChangeEvent<HTMLInputElement>) => {
            const next = event.currentTarget.value;
            defaultProps.onChange(next);
            rendererParams.onCellValueChanged(next);
        };

        return React.createElement("input", {
            "aria-label": label,
            className: "{{nameLower}}-text-editor",
            defaultValue: initialValue,
            dir: defaultProps.isRTLMode ? "rtl" : undefined,
            required: defaultProps.isRequired,
            type: "text",
            onBlur: () => rendererParams.stopEditing(false),
            onChange,
        });
    },
};
