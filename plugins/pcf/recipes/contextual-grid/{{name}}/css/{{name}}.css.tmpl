.{{cssClass}} {
  color: #323130;
  display: flex;
  flex-direction: column;
  font-family: "Segoe UI", Arial, sans-serif;
  gap: 0.5rem;
  width: 100%;
}

.{{cssMessageClass}} {
  color: #605e5c;
  font-size: 0.875rem;
}

.{{cssClass}}-tableWrap {
  overflow-x: auto;
  width: 100%;
}

.{{cssClass}}-table {
  border-collapse: collapse;
  font-size: 0.875rem;
  min-width: 100%;
}

.{{cssClass}}-table caption {
  font-weight: 600;
  padding: 0 0 0.25rem;
  text-align: left;
}

.{{cssClass}}-table th,
.{{cssClass}}-table td {
  border-bottom: 1px solid #edebe9;
  padding: 0.375rem 0.5rem;
  text-align: left;
  vertical-align: top;
}

.{{cssClass}}-table th {
  background: #faf9f8;
  font-weight: 600;
}

.{{cssClass}}-loadMore {
  align-self: flex-start;
  background: #ffffff;
  border: 1px solid #8a8886;
  border-radius: 2px;
  color: #323130;
  cursor: pointer;
  font: inherit;
  min-height: 2rem;
  padding: 0.25rem 0.75rem;
}

.{{cssClass}}-loadMore:disabled {
  color: #a19f9d;
  cursor: default;
}

.{{cssClass}}-loadMore[hidden],
.{{cssMessageClass}}[hidden] {
  display: none;
}