      "ofType": "SingleLine.Text",
      "usage": "input",
      "required": true
    },
    {
      "name": "fetchXmlTemplate",
      "displayNameKey": "FetchXmlTemplate_Display_Key",
      "descriptionKey": "FetchXmlTemplate_Desc_Key",
      "ofType": "Multiple",
      "usage": "input",
      "required": true
    },
    {
      "name": "pageSize",
      "displayNameKey": "PageSize_Display_Key",
      "descriptionKey": "PageSize_Desc_Key",
      "ofType": "Whole.None",
