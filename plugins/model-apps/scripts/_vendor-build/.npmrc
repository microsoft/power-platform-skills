# Never write registry URLs into this package-lock.json. See the repo-root .npmrc for the rationale.
#
# This copy is the load-bearing one: npm reads the per-project .npmrc from the directory that OWNS
# package.json and does NOT walk up, so the root .npmrc does not apply here -- `npm config get
# omit-lockfile-registry-resolved` reads false from this directory without this file.
omit-lockfile-registry-resolved=true
