<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="{{namespace}}" constructor="{{name}}" version="{{version}}" display-name-key="{{name}}" description-key="{{name}}_Description" control-type="virtual">
    <external-service-usage enabled="false" />
    <property name="sampleProperty" display-name-key="Property_Display_Key" description-key="Property_Desc_Key" of-type="SingleLine.Text" usage="bound" required="true" />
    <resources>
      <code path="index.ts" order="1" />
      <css path="css/{{name}}.css" order="1" />
      <resx path="strings/{{name}}.1033.resx" version="1.0.0" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>
    <!-- Features are declared only when this control's code uses them. -->
  </control>
</manifest>
