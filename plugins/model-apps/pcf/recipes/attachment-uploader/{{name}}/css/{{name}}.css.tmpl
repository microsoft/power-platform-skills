.{{cssClass}} {
  align-items: flex-start;
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  font-family: "Segoe UI", Arial, sans-serif;
}

.{{cssInputClass}}-label {
  color: #323130;
  font-size: 0.875rem;
  font-weight: 600;
}

.{{cssInputClass}}-button {
  background: #0078d4;
  border: 1px solid #0078d4;
  border-radius: 0.25rem;
  color: #ffffff;
  cursor: pointer;
  font: inherit;
  min-height: 2rem;
  padding: 0.25rem 0.75rem;
}

.{{cssInputClass}}-button:disabled {
  background: #f3f2f1;
  border-color: #c8c6c4;
  color: #605e5c;
  cursor: default;
}

.{{cssInputClass}}-button:focus {
  outline: 2px solid #005a9e;
  outline-offset: 1px;
}

.{{cssMessageClass}} {
  color: #605e5c;
  font-size: 0.8125rem;
}

.{{cssMessageClass}}-error {
  color: #a4262c;
}

