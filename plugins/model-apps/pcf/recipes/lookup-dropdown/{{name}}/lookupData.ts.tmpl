import { IInputs } from "./generated/ManifestTypes";

export type LookupOption = ComponentFramework.LookupValue;

type MetadataObject = Record<string, unknown>;

interface LookupMetadata {
    tableName: string;
    idColumn: string;
    nameColumn: string;
    activeFilter: string;
}

const PAGE_SIZE = 25;
const ACTIVE_LABEL = "active";

export async function loadLookupOptions(
    context: ComponentFramework.Context<IInputs>,
    lookup: ComponentFramework.PropertyTypes.LookupProperty,
): Promise<LookupOption[]> {
    const metadata = await readLookupMetadata(context, lookup);
    const select = `$select=${[metadata.idColumn, metadata.nameColumn].map(encodeURIComponent).join(",")}`;
    const filter = `$filter=${encodeURIComponent(metadata.activeFilter)}`;
    const orderBy = `$orderby=${encodeURIComponent(`${metadata.nameColumn} asc`)}`;
    const results: LookupOption[] = [];
    let options: string | undefined = `?${select}&${filter}&${orderBy}`;

    while (options) {
        const page = await context.webAPI.retrieveMultipleRecords(metadata.tableName, options, PAGE_SIZE);
        for (const row of page.entities) {
            const id = stringField(row, metadata.idColumn);
            if (!id) continue;
            results.push({
                id,
                name: stringField(row, metadata.nameColumn) || id,
                entityType: metadata.tableName,
            });
        }
        options = nextLinkOptions(page.nextLink);
    }

    return results;
}

async function readLookupMetadata(
    context: ComponentFramework.Context<IInputs>,
    lookup: ComponentFramework.PropertyTypes.LookupProperty,
): Promise<LookupMetadata> {
    if (typeof context.utils?.getEntityMetadata !== "function") {
        throw new Error("Lookup metadata is unavailable in this host.");
    }

    const tableName = lookup.getTargetEntityType();
    if (!tableName) throw new Error("This lookup is not bound to a target table.");

    const metadata = await context.utils.getEntityMetadata(tableName);
    const record = metadata as MetadataObject;
    const idColumn = stringMetadata(record, "PrimaryIdAttribute");
    const nameColumn = stringMetadata(record, "PrimaryNameAttribute");
    if (!idColumn || !nameColumn) {
        throw new Error("Lookup metadata did not include primary id and primary name columns.");
    }

    return {
        tableName,
        idColumn,
        nameColumn,
        activeFilter: activePredicate(record),
    };
}

function activePredicate(metadata: MetadataObject): string {
    const stateAttribute = attributes(metadata).find((attribute) => {
        const kind = stringMetadata(attribute, "AttributeType").toLowerCase();
        return kind === "state";
    });
    if (!stateAttribute) throw new Error("Lookup metadata did not include a state column.");

    const stateColumn = stringMetadata(stateAttribute, "LogicalName");
    const activeOption = optionSetOptions(stateAttribute).find((option) => {
        const label = optionLabel(option).toLowerCase();
        const invariantName = stringMetadata(option, "InvariantName").toLowerCase();
        return label === ACTIVE_LABEL || invariantName === ACTIVE_LABEL;
    });
    const activeValue = numericMetadata(activeOption, "Value");
    if (!stateColumn || activeValue === undefined) {
        throw new Error("Lookup metadata did not include an active state option.");
    }

    // The state column name and active value are metadata-derived because custom/stateful tables can
    // expose localized labels while A21 forbids hard-coding `statecode eq 0`.
    return `${stateColumn} eq ${activeValue}`;
}

function attributes(metadata: MetadataObject): MetadataObject[] {
    const raw = metadata.Attributes;
    if (Array.isArray(raw)) return raw.filter(isMetadataObject);
    if (isMetadataObject(raw)) return Object.values(raw).filter(isMetadataObject);
    return [];
}

function optionSetOptions(attribute: MetadataObject): MetadataObject[] {
    const optionSet = attribute.OptionSet;
    if (!isMetadataObject(optionSet)) return [];
    const options = optionSet.Options;
    return Array.isArray(options) ? options.filter(isMetadataObject) : [];
}

function optionLabel(option: MetadataObject): string {
    const label = option.Label;
    if (!isMetadataObject(label)) return "";
    const userLabel = label.UserLocalizedLabel;
    if (isMetadataObject(userLabel)) return stringMetadata(userLabel, "Label");
    const localized = label.LocalizedLabels;
    if (Array.isArray(localized)) {
        const first = localized.find(isMetadataObject);
        if (first) return stringMetadata(first, "Label");
    }
    return "";
}

function stringField(entity: ComponentFramework.WebApi.Entity, key: string): string {
    const value = entity[key];
    return typeof value === "string" ? value : value == null ? "" : String(value);
}

function stringMetadata(record: MetadataObject | undefined, key: string): string {
    if (!record) return "";
    const value = record[key];
    return typeof value === "string" ? value : "";
}

function numericMetadata(record: MetadataObject | undefined, key: string): number | undefined {
    if (!record) return undefined;
    const value = record[key];
    return typeof value === "number" ? value : undefined;
}

function isMetadataObject(value: unknown): value is MetadataObject {
    return !!value && typeof value === "object" && !Array.isArray(value);
}

function nextLinkOptions(nextLink: string | undefined): string | undefined {
    if (!nextLink) return undefined;
    if (nextLink.startsWith("?")) return nextLink;
    try {
        const parsed = new URL(nextLink);
        return `${parsed.search}${parsed.hash}`;
    } catch {
        return nextLink;
    }
}
