test("hides Dataverse annotation keys while keeping formatted lookup text", async () => {
    const mounted = mount({
        webAPI: mockWebApi({
            retrieveMultipleRecords: jest.fn(async (_entityLogicalName: string, _options?: string, _maxPageSize?: number) => response([{
                "alias.lookup": "44444444-4444-4444-8444-444444444444",
                "alias.lookup@OData.Community.Display.V1.FormattedValue": "Tailspin Toys",                [`alias.lookup@${DATAVERSE_CRM_ANNOTATION}.lookuplogicalname`]: "account",
                _ownerid_value: "33333333-3333-4333-8333-333333333333",
                "_ownerid_value@OData.Community.Display.V1.FormattedValue": "MOD Administrator",                [`_ownerid_value@${DATAVERSE_CRM_ANNOTATION}.associatednavigationproperty`]: "ownerid",
            }])),
        }),
    });

    await flushPromises();

    const headers = Array.from(mounted.container.querySelectorAll("th")).map((header) => header.textContent);
    expect(headers).toEqual(expect.arrayContaining(["alias.lookup", "ownerid"]));
    expect(headers).not.toContain(`alias.lookup@${DATAVERSE_CRM_ANNOTATION}.lookuplogicalname`);
    expect(headers).not.toContain(`_ownerid_value@${DATAVERSE_CRM_ANNOTATION}.associatednavigationproperty`);
    expect(mounted.container.textContent).toContain("Tailspin Toys");
    expect(mounted.container.textContent).toContain("MOD Administrator");
    expect(mounted.container.textContent).not.toContain("account");
    expect(mounted.container.textContent).not.toContain("owneridownerid");
});

test("load more follows documented nextLink paging", async () => {
    const retrieveMultipleRecords = jest.fn()
        .mockResolvedValueOnce(response([{ contactid: "1", fullname: "First" }], "https://contoso.crm.dynamics.com/api/data/v9.2/contacts?fetchXml=page2"))
        .mockResolvedValueOnce(response([{ contactid: "2", fullname: "Second" }]));
    const mounted = mount({ webAPI: mockWebApi({ retrieveMultipleRecords }) });

    await flushPromises();
    mounted.loadMore()?.dispatchEvent(new MouseEvent("click", { bubbles: true }));
    await flushPromises();

    expect(retrieveMultipleRecords).toHaveBeenNthCalledWith(2, "contact", "?fetchXml=page2", 25);
    expect(mounted.container.textContent).toContain("First");
    expect(mounted.container.textContent).toContain("Second");
});

test("two instances keep independent state and paging", async () => {
    const first = mount({ webAPI: mockWebApi({ retrieveMultipleRecords: jest.fn(async (_entityLogicalName: string, _options?: string, _maxPageSize?: number) => response([{ contactid: "1", fullname: "First" }])) }) });
    const second = mount({ webAPI: mockWebApi({ retrieveMultipleRecords: jest.fn(async (_entityLogicalName: string, _options?: string, _maxPageSize?: number) => response([{ contactid: "2", fullname: "Second" }])) }) });

    await flushPromises();

    expect(first.container.textContent).toContain("First");
    expect(first.container.textContent).not.toContain("Second");
    expect(second.container.textContent).toContain("Second");
    expect(first.container.querySelector(".{{cssClass}}")).not.toBe(second.container.querySelector(".{{cssClass}}"));
});