import { {{name}} } from "../{{name}}";
import { IInputs } from "../{{name}}/generated/ManifestTypes";
import { mockContext, mockProperty, mockWebApi } from "../test/pcf-context";

function withStrings(context: ComponentFramework.Context<IInputs>): ComponentFramework.Context<IInputs> {
    (context as ComponentFramework.Context<IInputs> & { resources: ComponentFramework.Resources }).resources = {
        getResource: (_id: string, success: (data: string) => void) => success(""),
        getString: (key: string) => ({
            ContextualGrid_Caption: "Related rows",
            ContextualGrid_Loading: "Loading related rows...",
            ContextualGrid_Unsaved: "Save this {0} record before related rows can be shown.",
            ContextualGrid_Configure: "Configure entityId, entityName and FetchXML before using this grid.",
            ContextualGrid_Permission: "You do not have permission to read this contextual grid configuration.",
            ContextualGrid_InvalidRecord: "The current record id is not a valid GUID.",
            ContextualGrid_MissingToken: "FetchXML must contain the {recordId} token.",
            ContextualGrid_Empty: "No related rows were found.",
            ContextualGrid_Error: "Unable to load related rows.",
            ContextualGrid_LoadMore: "Load more rows",
        }[key] ?? key),
    } as ComponentFramework.Resources;
    return context;
}

function response(entities: ComponentFramework.WebApi.Entity[], nextLink?: string): ComponentFramework.WebApi.RetrieveMultipleResponse {
    return { entities, nextLink } as ComponentFramework.WebApi.RetrieveMultipleResponse;
}

async function flushPromises(): Promise<void> {
    await Promise.resolve();
    await Promise.resolve();
    await new Promise((resolve) => setTimeout(resolve, 0));
    await Promise.resolve();
}

function mount(options: {
    entityId?: IInputs["entityId"];
    entityName?: IInputs["entityName"];
    fetchXmlTemplate?: IInputs["fetchXmlTemplate"];
    pageSize?: IInputs["pageSize"];
    disabled?: boolean;
    webAPI?: ComponentFramework.WebApi;
} = {}) {
    const control = new {{name}}();
    const notify = jest.fn();
    const container = document.createElement("div");
    const retrieveMultipleRecords = jest.fn(async (_entityLogicalName: string, _options?: string, _maxPageSize?: number) => response([
        { contactid: "11111111-1111-4111-8111-111111111111", fullname: "Adele Vance" },
    ]));
    const parameters: Partial<IInputs> = {};
    if (Object.prototype.hasOwnProperty.call(options, "entityId")) parameters.entityId = options.entityId; else parameters.entityId = mockProperty("{00000000-0000-4000-8000-000000000001}") as IInputs["entityId"];
    if (Object.prototype.hasOwnProperty.call(options, "entityName")) parameters.entityName = options.entityName; else parameters.entityName = mockProperty("account") as IInputs["entityName"];
    if (Object.prototype.hasOwnProperty.call(options, "fetchXmlTemplate")) parameters.fetchXmlTemplate = options.fetchXmlTemplate; else parameters.fetchXmlTemplate = mockProperty("<fetch><entity name=\"contact\"><filter><condition attribute=\"parentcustomerid\" operator=\"eq\" value=\"{recordId}\" /></filter></entity></fetch>") as IInputs["fetchXmlTemplate"];
    if (Object.prototype.hasOwnProperty.call(options, "pageSize")) parameters.pageSize = options.pageSize; else parameters.pageSize = mockProperty(25) as IInputs["pageSize"];
    const context = withStrings(mockContext<IInputs>(parameters, {
        disabled: options.disabled,
        webAPI: options.webAPI ?? mockWebApi({ retrieveMultipleRecords }),
    }));

    control.init(context, notify, {}, container);

    return {
        control,
        notify,
        container,
        context,
        retrieveMultipleRecords,
        status: () => container.querySelector("[role='status']") as HTMLDivElement,
        rows: () => Array.from(container.querySelectorAll("tbody tr")),
        loadMore: () => container.querySelector("button") as HTMLButtonElement | null,
    };
}

test("loads FetchXML with an escaped current record id and renders returned rows", async () => {
    const mounted = mount();

    await flushPromises();

    expect(mounted.retrieveMultipleRecords).toHaveBeenCalledWith(
        "contact",
        `?fetchXml=${encodeURIComponent("<fetch><entity name=\"contact\"><filter><condition attribute=\"parentcustomerid\" operator=\"eq\" value=\"00000000-0000-4000-8000-000000000001\" /></filter></entity></fetch>")}`,
        25,
    );
    expect(mounted.container.querySelector("caption")?.textContent).toBe("Related rows");
    expect(mounted.rows()).toHaveLength(1);
    expect(mounted.container.textContent).toContain("Adele Vance");
    expect(mounted.notify).not.toHaveBeenCalled();
});

test("missing parameter objects and unsaved records render safe disabled states", async () => {
    const missing = mount({ entityId: undefined as unknown as IInputs["entityId"] });
    const unsaved = mount({ entityId: mockProperty("") as IInputs["entityId"] });

    await flushPromises();

    expect(missing.status().textContent).toContain("Configure entityId");
    expect(missing.retrieveMultipleRecords).not.toHaveBeenCalled();
    expect(unsaved.status().textContent).toContain("Save this account record");
    expect(unsaved.retrieveMultipleRecords).not.toHaveBeenCalled();
});

test("security and disabled states prevent Web API calls without leaking configuration", async () => {
    const unreadable = mount({ fetchXmlTemplate: mockProperty("<fetch>{recordId}</fetch>", undefined, { readable: false }) as IInputs["fetchXmlTemplate"] });
    const readOnly = mount({ entityId: mockProperty("{00000000-0000-4000-8000-000000000001}", undefined, { editable: false }) as IInputs["entityId"] });
    const disabled = mount({ disabled: true });

    await flushPromises();

    expect(unreadable.status().textContent).toContain("permission");
    expect(unreadable.container.textContent).not.toContain("<fetch>");
    expect(unreadable.retrieveMultipleRecords).not.toHaveBeenCalled();
    expect(readOnly.container.textContent).toContain("Adele Vance");
    expect(readOnly.retrieveMultipleRecords).toHaveBeenCalledTimes(1);
    expect(disabled.container.querySelector("table")?.getAttribute("aria-disabled")).toBe("true");
});

test("malformed GUID braces render the invalid-record state without querying", async () => {
    const mounted = mount({ entityId: mockProperty("{00000000-0000-4000-8000-000000000001") as IInputs["entityId"] });

    await flushPromises();

    expect(mounted.status().textContent).toContain("not a valid GUID");
    expect(mounted.retrieveMultipleRecords).not.toHaveBeenCalled();
});
test("Web API permission failures and empty results render messages without notifying", async () => {
    const failed = mount({
        webAPI: mockWebApi({ retrieveMultipleRecords: jest.fn(async (_entityLogicalName: string, _options?: string, _maxPageSize?: number) => { throw new Error("Access denied"); }) }),
    });
    const empty = mount({
        webAPI: mockWebApi({ retrieveMultipleRecords: jest.fn(async (_entityLogicalName: string, _options?: string, _maxPageSize?: number) => response([])) }),
    });

    await flushPromises();

    expect(failed.status().textContent).toContain("Unable to load related rows");
    expect(empty.status().textContent).toContain("No related rows");
    expect(failed.notify).not.toHaveBeenCalled();
    expect(empty.notify).not.toHaveBeenCalled();
});

test("load more follows documented nextLink paging", async () => {
    const retrieveMultipleRecords = jest.fn()
        .mockResolvedValueOnce(response([{ contactid: "1", fullname: "First" }], "https://contoso.crm.dynamics.com/api/data/v9.2/contacts?fetchXml=page2"))
        .mockResolvedValueOnce(response([{ contactid: "2", fullname: "Second" }]));
    const mounted = mount({ webAPI: mockWebApi({ retrieveMultipleRecords }) });

    await flushPromises();
    mounted.loadMore()?.dispatchEvent(new MouseEvent("click", { bubbles: true }));
    await flushPromises();

    expect(retrieveMultipleRecords).toHaveBeenNthCalledWith(2, "contact", "?fetchXml=page2", 25);
    expect(mounted.container.textContent).toContain("First");
    expect(mounted.container.textContent).toContain("Second");
});

test("two instances keep independent state and paging", async () => {
    const first = mount({ webAPI: mockWebApi({ retrieveMultipleRecords: jest.fn(async (_entityLogicalName: string, _options?: string, _maxPageSize?: number) => response([{ contactid: "1", fullname: "First" }])) }) });
    const second = mount({ webAPI: mockWebApi({ retrieveMultipleRecords: jest.fn(async (_entityLogicalName: string, _options?: string, _maxPageSize?: number) => response([{ contactid: "2", fullname: "Second" }])) }) });

    await flushPromises();

    expect(first.container.textContent).toContain("First");
    expect(first.container.textContent).not.toContain("Second");
    expect(second.container.textContent).toContain("Second");
    expect(first.container.querySelector(".{{cssClass}}")).not.toBe(second.container.querySelector(".{{cssClass}}"));
});