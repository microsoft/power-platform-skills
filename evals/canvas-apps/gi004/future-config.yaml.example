# GI-004: Screen Completeness Evaluation
# READY TO USE — Rename to static.yaml when apps.json is populated
#
# Tests whether Canvas Apps have complete functional journeys (GI-004).
# The observable symptom is empty destination screens; the actual bug is
# incomplete journeys that cannot complete due to missing content/controls.
#
# Prerequisites:
#   1. Copy apps.json.template to apps.json and populate with Player URLs
#   2. Build EvalCLI from padsml branch: users/maasadiz/evalcli-canvas-external-apps
#   3. Rename this file to static.yaml
#
# Pipeline flow:
#   external-apps -> local-user-journeys -> cua -> grade-functionality
#
# Canvas Apps have .pa.yaml source synced locally, but existing Player-URL
# apps have no App_Definition artifact registered in Eval storage.
#
# Authentication:
#   If your Canvas apps require authentication, provide Playwright storage state:
#   - Option 1: Set CANVAS_PLAYER_STORAGE_STATE env var
#   - Option 2: Add player-storage-state to external-apps config below

steps:
  - external-apps
  - local-user-journeys
  - cua
  - grade-functionality

external-apps:
  apps-file: apps.json  # { "name": "...", "player_url": "..." }
  # player-storage-state: auth/storage-state.json  # Optional: Playwright storage state

local-user-journeys:
  files:
    - journeys/core-lifecycle.yaml
    - journeys/validation-guards.yaml

cua:
  concurrency: 1  # Canvas apps require concurrency=1 (isolated browser contexts)
  timeout_seconds: 1800  # 30 minutes per app (Canvas apps can be slow)
  max_turns: 80  # High turn limit for multi-step journeys

grade-functionality:
  model: gpt-4o

tags:
  - canvas-apps
  - screen-completeness
  - gi004

metadata:
  issue_id: GI-004
  issue_title: "Verify complete core functional journeys after compilation"
  severity: critical
  category: skill
  affected_trains: 53/103
  priority: P1
