  "businessProcessFlows": [
    { "entity": "cnt_claim", "name": "Claim handling", "reconcile": "declared",
      "description": "How a claim moves from intake to a decision.",
      "status": "Active", "order": 1,
      "stages": [
        { "key": "intake", "name": "Intake", "steps": [
          { "key": "policy", "name": "Policy number", "field": "cnt_policynumber", "required": true },
          { "key": "amount", "name": "Claimed amount", "field": "cnt_amount" } ] },
        { "key": "assess", "name": "Assess", "steps": [
          { "key": "assessor", "name": "Assessor", "field": "cnt_assessor", "required": true },
          { "key": "assessment", "name": "Assessment", "field": "cnt_assessment" } ] },
        { "key": "decide", "name": "Decide", "steps": [
          { "key": "decision", "name": "Decision", "field": "cnt_decision", "required": true } ] }
      ] }
  ],
  "appShell": { "areas": [{ "label": "Claims", "groups": [{ "label": "Work", "subAreas": [
    { "entity": "cnt_claim", "title": "Claims" }
  ] }] }] }
}