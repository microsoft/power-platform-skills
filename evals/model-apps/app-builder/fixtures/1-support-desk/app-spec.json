{
  "solution": {
    "uniqueName": "ContosoSupportDesk",
    "displayName": "Contoso Support Desk",
    "publisherPrefix": "new"
  },
  "app": {
    "name": "Support Desk",
    "description": "Manage customers, their support tickets, and ticket comments"
  },
  "entities": [
    {
      "schemaName": "new_customer",
      "displayName": "Customer",
      "pluralName": "Customers",
      "primaryAttribute": {
        "schemaName": "new_name",
        "displayName": "Customer Name"
      },
      "columns": [
        {
          "schemaName": "new_segment",
          "displayName": "Segment",
          "type": "Choice",
          "options": [
            "Enterprise",
            "Mid-Market",
            "Small Business"
          ]
        },
        {
          "schemaName": "new_accountmanager",
          "displayName": "Account Manager",
          "type": "Text"
        }
      ],
      "vectorIcon": "new_customer_icon",
      "iconDescription": "a single person bust inside a rounded square"
    },
    {
      "schemaName": "new_ticket",
      "displayName": "Ticket",
      "pluralName": "Tickets",
      "primaryAttribute": {
        "schemaName": "new_name",
        "displayName": "Title"
      },
      "columns": [
        {
          "schemaName": "new_priority",
          "displayName": "Priority",
          "type": "Choice",
          "options": [
            "Low",
            "Medium",
            "High",
            "Critical"
          ]
        },
        {
          "schemaName": "new_status",
          "displayName": "Status",
          "type": "Choice",
          "options": [
            "New",
            "In Progress",
            "Resolved",
            "Closed"
          ]
        },
        {
          "schemaName": "new_duedate",
          "displayName": "Due Date",
          "type": "DateTime"
        },
        {
          "schemaName": "new_description",
          "displayName": "Description",
          "type": "Memo"
        }
      ],
      "vectorIcon": "new_ticket_icon",
      "iconDescription": "an outlined clipboard with a checkmark on the page"
    },
    {
      "schemaName": "new_comment",
      "displayName": "Comment",
      "pluralName": "Comments",
      "primaryAttribute": {
        "schemaName": "new_name",
        "displayName": "Comment"
      },
      "columns": [
        {
          "schemaName": "new_body",
          "displayName": "Body",
          "type": "Memo"
        },
        {
          "schemaName": "new_author",
          "displayName": "Author",
          "type": "Text"
        },
        {
          "schemaName": "new_postedon",
          "displayName": "Posted On",
          "type": "DateTime"
        }
      ],
      "vectorIcon": "new_comment_icon",
      "iconDescription": "a rounded speech bubble with a tail at the lower left"
    }
  ],
  "relationships": [
    {
      "type": "OneToMany",
      "referenced": "new_customer",
      "referencing": "new_ticket",
      "lookup": {
        "schemaName": "new_CustomerId",
        "displayName": "Customer"
      }
    },
    {
      "type": "OneToMany",
      "referenced": "new_ticket",
      "referencing": "new_comment",
      "lookup": {
        "schemaName": "new_TicketId",
        "displayName": "Ticket"
      }
    }
  ],
  "forms": [
    {
      "entity": "new_customer",
      "type": "main",
      "name": "Customer",
      "layout": "auto",
      "subgrids": [
        {
          "childEntity": "new_ticket",
          "view": "Active Tickets",
          "label": "Related Tickets"
        }
      ]
    },
    {
      "entity": "new_ticket",
      "type": "main",
      "name": "Ticket",
      "layout": "auto",
      "purpose": "tracking",
      "subgrids": [
        {
          "childEntity": "new_comment",
          "view": "Active Comments",
          "label": "Related Comments"
        }
      ]
    },
    {
      "entity": "new_comment",
      "type": "main",
      "name": "Comment",
      "layout": "auto"
    }
  ],
  "views": [
    {
      "entity": "new_customer",
      "type": "main",
      "name": "Active Customers",
      "columns": [
        "new_name",
        "new_segment",
        "new_accountmanager"
      ],
      "sort": [
        {
          "attr": "new_name",
          "dir": "asc"
        }
      ],
      "activeOnly": true
    },
    {
      "entity": "new_ticket",
      "type": "main",
      "name": "Active Tickets",
      "columns": [
        "new_name",
        "new_priority",
        "new_status",
        "new_duedate"
      ],
      "sort": [
        {
          "attr": "new_duedate",
          "dir": "asc"
        }
      ],
      "activeOnly": true
    },
    {
      "entity": "new_comment",
      "type": "main",
      "name": "Active Comments",
      "columns": [
        "new_name",
        "new_author",
        "new_postedon"
      ],
      "sort": [
        {
          "attr": "new_postedon",
          "dir": "desc"
        }
      ],
      "activeOnly": true
    }
  ],
  "charts": [
    {
      "entity": "new_ticket",
      "name": "Tickets by Priority",
      "groupBy": "new_priority",
      "measure": "count",
      "chartType": "Pie"
    },
    {
      "entity": "new_ticket",
      "name": "Tickets by Status",
      "groupBy": "new_status",
      "measure": "count",
      "chartType": "Column"
    }
  ],
  "appShell": {
    "areas": [
      {
        "label": "Service",
        "groups": [
          {
            "label": "Support",
            "subAreas": [
              {
                "entity": "new_customer",
                "title": "Customers"
              },
              {
                "entity": "new_ticket",
                "title": "Tickets"
              },
              {
                "entity": "new_comment",
                "title": "Comments"
              }
            ]
          }
        ]
      }
    ]
  },
