  "personas": [
    {
      "persona": "Support Agent",
      "jobs": [
        {
          "name": "Handle tickets",
          "privileges": [
            {
              "entity": "new_ticket",
              "access": [
                "read",
                "write",
                "create"
              ],
              "scope": "businessUnit"
            },
            {
              "entity": "new_comment",
              "access": [
                "read",
                "create"
              ],
              "scope": "businessUnit"
            },
            {
              "entity": "new_customer",
              "access": [
                "read"
              ],
              "scope": "organization"
            }
          ],
          "surfaces": [
            "Active Tickets",
            "Ticket"
          ]
        }
      ]
    },
    {
      "persona": "Support Lead",
      "jobs": [
        {
          "name": "Oversee the queue",
          "privileges": [
            {
              "entity": "new_ticket",
              "access": [
                "read",
                "write",
                "create",
                "delete",
                "assign"
              ],
              "scope": "organization"
            },
            {
              "entity": "new_customer",
              "access": [
                "read",
                "write"
              ],
              "scope": "organization"
            }
          ],
          "surfaces": [
            "Active Tickets",
            "Active Customers"
          ]
        }
      ]
    }
  ],
