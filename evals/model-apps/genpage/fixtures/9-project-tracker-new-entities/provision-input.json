{
  "solution": {
    "uniqueName": "ContosoProjects",
    "publisherPrefix": "cr"
  },
  "entities": [
    {
      "schemaName": "cr_Project",
      "displayName": "Project",
      "pluralName": "Projects",
      "description": "A tracked project with an owner, schedule, budget and status.",
      "primaryAttribute": {
        "schemaName": "cr_Name",
        "displayName": "Project Name",
        "maxLength": 100
      },
      "columns": [
        { "schemaName": "cr_Manager", "displayName": "Project Manager", "type": "Text", "maxLength": 100, "required": true },
        { "schemaName": "cr_StartDate", "displayName": "Start Date", "type": "DateTime", "dateFormat": "DateOnly", "required": true },
        { "schemaName": "cr_TargetDate", "displayName": "Target Date", "type": "DateTime", "dateFormat": "DateOnly", "required": true },
        { "schemaName": "cr_Budget", "displayName": "Budget", "type": "Money", "precision": 2, "minValue": 0 },
        { "schemaName": "cr_Status", "displayName": "Status", "type": "Choice", "options": ["Planning", "Active", "On Hold", "Completed"] }
      ]
    },
    {
      "schemaName": "cr_Milestone",
      "displayName": "Milestone",
      "pluralName": "Milestones",
      "description": "A dated checkpoint that belongs to one project.",
      "primaryAttribute": {
        "schemaName": "cr_Name",
        "displayName": "Milestone Name",
        "maxLength": 100
      },
      "columns": [
        { "schemaName": "cr_DueDate", "displayName": "Due Date", "type": "DateTime", "dateFormat": "DateOnly", "required": true },
        { "schemaName": "cr_PercentComplete", "displayName": "Percent Complete", "type": "Integer", "minValue": 0, "maxValue": 100 },
        { "schemaName": "cr_Status", "displayName": "Status", "type": "Choice", "options": ["Not Started", "In Progress", "Completed", "Blocked"] }
      ]
    }
  ],
  "relationships": [
    {
      "type": "OneToMany",
      "schemaName": "cr_project_cr_milestone",
      "referenced": "cr_Project",
      "referencing": "cr_Milestone",
      "lookup": {
        "schemaName": "cr_Project",
        "displayName": "Project"
      },
      "cascadeDelete": "RemoveLink"
    }
  ],
